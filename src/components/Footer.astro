---
/**
 * Footer: brand + WhatsApp contact, three link columns and a bottom bar.
 * Also renders the mobile-only floating WhatsApp button, which appears
 * after ~600px of scroll and steps aside over [data-wa-fab-hide] blocks.
 */
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import { SITE, waLink, WA_START_TEXT } from '../lib/site';

interface FooterColumn {
  title: string;
  links: { label: string; href: string }[];
}

const columns: FooterColumn[] = [
  {
    title: 'Producto',
    links: [
      { label: 'Beneficios', href: '#beneficios' },
      { label: 'Cómo funciona', href: '#como-funciona' },
      { label: 'Calculadora', href: '#calculadora' },
      { label: 'Precios', href: '#precios' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Comparativa', href: '#comparativa' },
      { label: 'Preguntas frecuentes', href: '#preguntas' },
    ],
  },
  {
    title: 'Contacto',
    links: [
      { label: 'WhatsApp', href: waLink() },
      { label: 'Unirme a la beta', href: waLink('Hola SmartSavings, quiero unirme a la beta') },
    ],
  },
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
const externalAttrs = { target: '_blank', rel: 'noopener noreferrer' };
---

<footer class="border-t border-line bg-surface">
  <div class="container-page pt-12 pb-24 sm:pt-16 lg:pb-16">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="#inicio" class="inline-flex rounded-lg">
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-pretty text-body">
          Tu asistente de gastos en WhatsApp. Registra con un audio, una foto o un texto.
        </p>
        <a
          href={waLink()}
          class="mt-6 inline-flex h-10 items-center gap-2 rounded-full border border-line bg-surface px-4 text-sm font-medium text-ink shadow-card transition-colors hover:border-zinc-300 hover:bg-canvas"
          {...externalAttrs}
        >
          <Icon name="whatsapp" class="size-4 text-brand-600" />
          <span class="tabular">{SITE.whatsappDisplay}</span>
        </a>
      </div>

      <nav aria-label="Pie de página" class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:col-span-7">
        {
          columns.map(({ title, links }) => (
            <div>
              <h2 class="font-mono text-xs font-medium tracking-wider text-muted uppercase">{title}</h2>
              <ul class="mt-4 space-y-1">
                {links.map(({ label, href }) => (
                  <li>
                    <a
                      href={href}
                      class="group inline-flex items-center gap-1 rounded-md py-1.5 text-sm text-body transition-colors hover:text-ink"
                      {...(isExternal(href) ? externalAttrs : {})}
                    >
                      {label}
                      {isExternal(href) && (
                        <Icon
                          name="arrow-up-right"
                          class="size-3.5 text-subtle transition-colors group-hover:text-ink"
                        />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-sm text-muted">
      <p>© {SITE.year} SmartSavings. Todos los derechos reservados.</p>
      <p>Hecho en Colombia</p>
    </div>
  </div>

  <a
    href={waLink(WA_START_TEXT)}
    aria-label="Escribir a SmartSavings por WhatsApp"
    aria-hidden="true"
    tabindex="-1"
    data-wa-fab
    data-visible="false"
    class="fixed right-5 bottom-5 z-40 inline-flex size-14 items-center justify-center rounded-full bg-brand-600 text-white shadow-float transition-[opacity,translate,background-color] duration-300 ease-out-soft hover:bg-brand-700 data-[visible=false]:pointer-events-none data-[visible=false]:translate-y-3 data-[visible=false]:opacity-0 motion-reduce:transition-none lg:hidden"
    {...externalAttrs}
  >
    <Icon name="whatsapp" class="size-7" />
  </a>
</footer>

<script>
  const fab = document.querySelector<HTMLAnchorElement>('[data-wa-fab]');

  if (fab) {
    const THRESHOLD = 600;
    const covering = new Set<Element>();
    let visible = false;
    let frame = 0;

    const render = () => {
      frame = 0;
      const next = window.scrollY > THRESHOLD && covering.size === 0;
      if (next === visible) return;
      visible = next;
      fab.dataset.visible = String(next);
      if (next) {
        fab.removeAttribute('tabindex');
        fab.removeAttribute('aria-hidden');
      } else {
        fab.setAttribute('tabindex', '-1');
        fab.setAttribute('aria-hidden', 'true');
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    window.addEventListener('scroll', schedule, { passive: true });

    const blockers = document.querySelectorAll('[data-wa-fab-hide]');
    if (blockers.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) covering.add(entry.target);
          else covering.delete(entry.target);
        }
        schedule();
      });
      blockers.forEach((el) => io.observe(el));
    }

    render();
  }
</script>
