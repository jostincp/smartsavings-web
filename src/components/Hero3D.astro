---
// Hero3D.astro
---

<section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden pt-28 pb-16 sm:pb-24 bg-[#F5F9FA] bg-grid-dots">
  
  <!-- Glowing Ambient Radial Halos -->
  <div class="pointer-events-none absolute -top-24 right-0 w-[600px] sm:w-[900px] h-[600px] sm:h-[900px] rounded-full bg-[radial-gradient(circle,rgba(107,165,200,0.18)_0%,rgba(127,189,163,0.12)_35%,transparent_70%)] blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 -left-20 w-[500px] sm:w-[700px] h-[500px] sm:h-[700px] rounded-full bg-[radial-gradient(circle,rgba(212,165,116,0.14)_0%,rgba(107,165,200,0.08)_40%,transparent_70%)] blur-2xl"></div>

  <!-- Giant Background Soft Orb (Inspired by reference mockup) -->
  <div class="pointer-events-none absolute -right-[15%] top-1/2 -translate-y-1/2 w-[700px] h-[700px] lg:w-[1050px] lg:h-[1050px] bg-gradient-to-br from-[#FDF6E8]/70 to-[#EDF6F9]/60 rounded-full blur-xl z-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Value Proposition (Cols 1-7) -->
      <div class="lg:col-span-7 space-y-7 z-20">
        
        <!-- Live Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/90 border border-[#6BA5C8]/30 shadow-xs text-xs font-semibold text-[#2C4A5E]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7FBDA3] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2ECC71]"></span>
          </span>
          <span class="tracking-wide text-[#2C4A5E]/90">
            ASISTENTE FINANCIERO CON IA EN WHATSAPP
          </span>
          <span class="hidden sm:inline text-[#7FBDA3] font-bold">· Cero Fricción</span>
        </div>

        <!-- Main Headline -->
        <div class="space-y-2">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.08] text-[#2C4A5E]">
            Detén la <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#6BA5C8] via-[#4A8EB8] to-[#2C4A5E]">fuga de dinero</span> quincenal.
          </h1>
          <p class="text-2xl sm:text-3xl font-bold text-[#6BA5C8] tracking-tight">
            Tus finanzas en WhatsApp con Inteligencia Artificial.
          </p>
        </div>

        <!-- Body Pitch -->
        <p class="text-base sm:text-lg text-[#4A5568] leading-relaxed max-w-2xl">
          ¿Llegas a fin de quincena sin saber a dónde se fue tu sueldo? Registra gastos en <strong>2 segundos</strong> enviando un audio, texto o una foto de tu factura. 
          <span class="text-[#2C4A5E] font-medium">DeepSeek Chat</span>, <span class="text-[#2C4A5E] font-medium">Gemini 2.5 Flash</span> y <span class="text-[#2C4A5E] font-medium">Whisper</span> clasifican cada peso automáticamente.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          
          <a 
            href="https://wa.me/573332937647" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-[#25D366] to-[#128C7E] text-white font-bold text-base shadow-xl shadow-emerald-500/25 hover:shadow-2xl hover:shadow-emerald-500/35 hover:-translate-y-1 active:translate-y-0 transition-all text-center"
          >
            <!-- WhatsApp SVG Icon -->
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Chatear con SmartSavings</span>
            <span class="inline-block text-xs bg-white/20 py-0.5 px-2 rounded-full">Gratis</span>
          </a>

          <a 
            href="#simulador" 
            class="group inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white/90 hover:bg-white text-[#2C4A5E] font-semibold text-base border border-slate-200 shadow-md shadow-slate-200/50 hover:border-[#6BA5C8]/40 hover:-translate-y-1 transition-all text-center"
          >
            <span>Probar Simulador en Vivo</span>
            <svg class="w-4 h-4 text-[#6BA5C8] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

        </div>

        <!-- Trust Stats Badges -->
        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-slate-200/70 max-w-xl">
          <div>
            <div class="text-xl sm:text-2xl font-black text-[#2C4A5E]">&lt; 1.5s</div>
            <div class="text-xs text-[#4A5568] font-medium">Respuesta instantánea</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-[#7FBDA3]">100%</div>
            <div class="text-xs text-[#4A5568] font-medium">Privado y sin claves</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-[#D4A574]">0 Apps</div>
            <div class="text-xs text-[#4A5568] font-medium">Todo por WhatsApp</div>
          </div>
        </div>

      </div>

      <!-- Right Column: 3D Stage & Interactive Parallax Tilt (Cols 8-12) -->
      <div class="lg:col-span-5 relative flex justify-center items-center">
        
        <!-- 3D Interactive Card Frame -->
        <div id="hero3dContainer" class="relative w-full max-w-[500px] preserve-3d cursor-pointer">
          
          <!-- Glowing Aura Behind Mascot -->
          <div class="absolute inset-0 bg-gradient-to-tr from-[#6BA5C8]/30 via-[#7FBDA3]/25 to-[#D4A574]/30 rounded-full blur-3xl scale-95 animate-pulse-glow pointer-events-none"></div>

          <!-- Main 3D Mascot Render with Floating Animation -->
          <div class="relative z-10 transition-transform duration-300 ease-out" id="heroMascot">
            <img 
              src="/hero-image.png" 
              alt="SmartSavings Asistente 3D en WhatsApp" 
              class="w-full h-auto object-contain filter drop-shadow-[0_20px_35px_rgba(44,74,94,0.18)] select-none pointer-events-none"
              loading="eager"
            />
          </div>

          <!-- Floating 3D Coin Badge 1 -->
          <div class="absolute -top-4 -right-4 z-20 animate-coin-bob pointer-events-none">
            <div class="w-14 h-14 rounded-full bg-gradient-to-tr from-[#D4A574] via-[#F5B041] to-[#FFE082] p-1 shadow-lg shadow-amber-500/30 flex items-center justify-center border-2 border-white">
              <span class="text-white font-black text-xl drop-shadow-xs">$</span>
            </div>
          </div>

          <!-- Floating 3D Card Top-Left: Audio Whisper Note -->
          <div class="absolute -top-3 -left-6 sm:-left-12 z-20 animate-float-slow max-w-[210px] hidden sm:block pointer-events-none">
            <div class="glass-panel rounded-2xl p-3 shadow-xl border border-white/90 text-xs">
              <div class="flex items-center gap-2 mb-1">
                <span class="w-6 h-6 rounded-full bg-[#6BA5C8]/20 flex items-center justify-center text-xs">🎙️</span>
                <span class="font-bold text-[#2C4A5E]">Audio Whisper</span>
              </div>
              <p class="text-[11px] text-[#4A5568] leading-tight">
                "Flota a Tunja $25.000" <br />
                <span class="text-[#2ECC71] font-semibold">✓ Categorizado en Viajes</span>
              </p>
            </div>
          </div>

          <!-- Floating 3D Card Bottom-Right: OCR Gemini Bill -->
          <div class="absolute -bottom-6 -right-4 sm:-right-8 z-20 animate-float-reverse max-w-[220px] hidden sm:block pointer-events-none">
            <div class="glass-panel rounded-2xl p-3.5 shadow-xl border border-white/90 text-xs">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-6 h-6 rounded-full bg-[#7FBDA3]/30 flex items-center justify-center text-xs">🧾</span>
                <span class="font-bold text-[#2C4A5E]">Factura Gemini OCR</span>
              </div>
              <div class="text-[11px] text-[#4A5568] space-y-0.5">
                <div class="flex justify-between">
                  <span>Mercado Éxito:</span>
                  <span class="font-bold text-[#2C4A5E]">$64.200</span>
                </div>
                <div class="text-[#7FBDA3] font-semibold text-[10px]">
                  ✓ Desglosado ítem por ítem
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Badge Bottom-Left: Recordatorio Cierre -->
          <div class="absolute bottom-6 -left-6 z-20 hidden md:flex items-center gap-2 px-3 py-2 rounded-full glass-panel shadow-md text-xs font-semibold text-[#2C4A5E] border border-white">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>⏰ Cierre Diario: 2:00 PM y 8:00 PM</span>
          </div>

        </div>

      </div>

    </div>
  </div>

</section>

<!-- Interactive 3D Mouse Parallax Tilt Script -->
<script>
  const container = document.getElementById('hero3dContainer');
  const mascot = document.getElementById('heroMascot');

  if (container && mascot) {
    let bounds: DOMRect;

    function onMouseEnter() {
      bounds = container.getBoundingClientRect();
      document.addEventListener('mousemove', onMouseMove);
    }

    function onMouseMove(e: MouseEvent) {
      if (!bounds) bounds = container.getBoundingClientRect();
      const mouseX = e.clientX;
      const mouseY = e.clientY;
      const leftX = mouseX - bounds.x;
      const topY = mouseY - bounds.y;
      const center = {
        x: leftX - bounds.width / 2,
        y: topY - bounds.height / 2
      };
      
      const distance = Math.sqrt(center.x ** 2 + center.y ** 2);
      
      // Calculate 3D tilt angles
      const rotateX = (-center.y / 18).toFixed(2);
      const rotateY = (center.x / 18).toFixed(2);

      mascot.style.transform = `
        perspective(1000px)
        rotateX(${rotateX}deg)
        rotateY(${rotateY}deg)
        scale3d(1.03, 1.03, 1.03)
      `;
    }

    function onMouseLeave() {
      document.removeEventListener('mousemove', onMouseMove);
      mascot.style.transform = `
        perspective(1000px)
        rotateX(0deg)
        rotateY(0deg)
        scale3d(1, 1, 1)
      `;
    }

    container.addEventListener('mouseenter', onMouseEnter);
    container.addEventListener('mouseleave', onMouseLeave);
  }
</script>
