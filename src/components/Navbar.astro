---
// Navbar.astro
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-3 sm:py-4 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <nav class="glass-panel rounded-2xl sm:rounded-full px-4 sm:px-6 py-3 flex items-center justify-between shadow-lg shadow-[#2C4A5E]/5 border border-white/60">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 group focus:outline-none" aria-label="SmartSavings Home">
        <div class="relative w-10 h-10 sm:w-11 sm:h-11 rounded-2xl flex items-center justify-center p-1 bg-gradient-to-br from-[#6BA5C8]/20 to-[#7FBDA3]/30 border border-white shadow-sm group-hover:scale-105 transition-transform">
          <img src="/logo.svg" alt="SmartSavings Mascot" class="w-full h-full object-contain filter drop-shadow-sm" />
          <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-[#2ECC71] rounded-full border-2 border-white shadow-xs"></div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-lg sm:text-xl tracking-tight text-[#2C4A5E] group-hover:text-[#6BA5C8] transition-colors">
              Smart<span class="text-[#6BA5C8]">Savings</span>
            </span>
          </div>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-[#7FBDA3] -mt-1 hidden sm:block">
            Finanzas en WhatsApp
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex items-center gap-7 text-[14px] font-medium text-[#2C4A5E]/80">
        <a href="#como-funciona" class="hover:text-[#6BA5C8] transition-colors">Cómo Funciona</a>
        <a href="#ecosistema-3d" class="hover:text-[#6BA5C8] transition-colors">Ecosistema 3D</a>
        <a href="#simulador" class="hover:text-[#6BA5C8] transition-colors flex items-center gap-1.5">
          <span>Simulador</span>
          <span class="bg-[#7FBDA3]/20 text-[#2C4A5E] text-[10px] font-bold px-1.5 py-0.5 rounded-full">En Vivo</span>
        </a>
        <a href="#calculadora" class="hover:text-[#6BA5C8] transition-colors">Calculadora</a>
        <a href="#comparativa" class="hover:text-[#6BA5C8] transition-colors">Comparativa</a>
        <a href="#precios" class="hover:text-[#6BA5C8] transition-colors">Precios</a>
        <a href="#faq" class="hover:text-[#6BA5C8] transition-colors">FAQ</a>
      </div>

      <!-- Action Button (Desktop & Tablet) -->
      <div class="flex items-center gap-3">
        <!-- Live status badge -->
        <div class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/60 text-xs font-semibold text-emerald-800">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>IA en Vivo</span>
        </div>

        <a 
          href="https://wa.me/573332937647" 
          target="_blank" 
          rel="noopener noreferrer"
          class="group relative inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full bg-gradient-to-r from-[#25D366] to-[#128C7E] text-white font-semibold text-xs sm:text-sm shadow-md shadow-emerald-500/25 hover:shadow-lg hover:shadow-emerald-500/35 hover:-translate-y-0.5 active:translate-y-0 transition-all overflow-hidden"
        >
          <!-- WhatsApp Icon -->
          <svg class="w-4 h-4 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="relative">Chatear Gratis</span>
          <!-- subtle shimmer highlight -->
          <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
        </a>

        <!-- Mobile menu hamburger button -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          class="lg:hidden p-2 rounded-xl text-[#2C4A5E] hover:bg-slate-100/80 transition-colors focus:outline-none"
          aria-label="Abrir Menú"
        >
          <svg id="hamburgerIcon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="closeIcon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </nav>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobileMenu" class="hidden lg:hidden max-w-7xl mx-auto mt-2">
    <div class="glass-panel rounded-2xl p-6 shadow-xl space-y-4 border border-white/80">
      <div class="flex flex-col space-y-3 font-medium text-base text-[#2C4A5E]">
        <a href="#como-funciona" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors">Cómo Funciona</a>
        <a href="#ecosistema-3d" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors">Ecosistema 3D</a>
        <a href="#simulador" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors flex items-center justify-between">
          <span>Simulador en Vivo</span>
          <span class="bg-[#7FBDA3]/20 text-[#2C4A5E] text-xs font-bold px-2 py-0.5 rounded-full">Interactivo</span>
        </a>
        <a href="#calculadora" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors">Calculadora de Fuga</a>
        <a href="#comparativa" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors">Comparativa WhatsApp</a>
        <a href="#precios" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors">Precios Beta</a>
        <a href="#faq" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-slate-100/70 transition-colors">Preguntas Frecuentes</a>
      </div>
      <div class="pt-4 border-t border-slate-200/60">
        <a 
          href="https://wa.me/573332937647" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 w-full py-3 rounded-xl bg-gradient-to-r from-[#25D366] to-[#128C7E] text-white font-bold text-center shadow-md shadow-emerald-500/20"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Abrir en WhatsApp (+57 333 293 7647)
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
