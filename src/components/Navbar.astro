---
// Fixed top navigation: logo, section links with scroll-spy, WhatsApp CTA
// and a disclosure-style mobile menu.
import Icon from './ui/Icon.astro';
import Button from './ui/Button.astro';
import Logo from './ui/Logo.astro';
import { SITE, waLink, WA_START_TEXT, NAV_LINKS } from '../lib/site';

const startHref = waLink(WA_START_TEXT);
---

<header
  data-navbar
  class="fixed inset-x-0 top-0 z-50 h-16 border-b border-transparent bg-surface/95 backdrop-blur-md transition-[background-color,border-color] duration-300 supports-[backdrop-filter]:bg-surface/80 data-[open]:border-line data-[open]:bg-surface data-[scrolled]:border-line"
>
  <div class="container-page flex h-full items-center justify-between gap-6 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a href="#inicio" aria-label="SmartSavings — inicio" class="inline-flex items-center justify-self-start rounded-lg">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="group relative inline-flex items-center rounded-full px-3 py-2 text-sm font-medium text-body transition-colors duration-200 hover:bg-canvas hover:text-ink aria-[current=true]:text-ink"
              >
                {link.label}
                <span
                  class="absolute bottom-0.5 left-1/2 size-1 -translate-x-1/2 rounded-full bg-brand-500 opacity-0 transition-opacity duration-200 group-aria-[current=true]:opacity-100"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center justify-end gap-2 justify-self-end">
      <div class="hidden sm:flex">
        <Button size="sm" href={startHref} icon="whatsapp">Empezar gratis</Button>
      </div>
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="group -mr-2 inline-flex size-10 items-center justify-center rounded-full text-ink transition-colors duration-200 hover:bg-canvas aria-expanded:bg-canvas lg:hidden"
      >
        <span class="relative size-5">
          <Icon
            name="menu"
            class="absolute inset-0 size-5 transition-[opacity,rotate,scale] duration-200 ease-out-soft group-aria-expanded:scale-75 group-aria-expanded:rotate-45 group-aria-expanded:opacity-0"
          />
          <Icon
            name="x"
            class="absolute inset-0 size-5 scale-75 -rotate-45 opacity-0 transition-[opacity,rotate,scale] duration-200 ease-out-soft group-aria-expanded:scale-100 group-aria-expanded:rotate-0 group-aria-expanded:opacity-100"
          />
        </span>
      </button>
    </div>
  </div>

  <div
    data-nav-scrim
    hidden
    aria-hidden="true"
    class="absolute inset-x-0 top-[calc(100%+1px)] h-dvh bg-ink/20 opacity-0 transition-opacity duration-200 data-[state=open]:opacity-100 lg:hidden"
  >
  </div>

  <div
    id="menu-movil"
    data-nav-panel
    hidden
    inert
    class="absolute inset-x-0 top-[calc(100%+1px)] max-h-[calc(100dvh-4rem)] -translate-y-2 overflow-y-auto overscroll-contain border-b border-line bg-surface opacity-0 shadow-elevated transition-[opacity,translate] duration-200 ease-out-soft data-[state=open]:translate-y-0 data-[state=open]:opacity-100 motion-reduce:translate-y-0 lg:hidden"
  >
    <div class="container-page pt-2 pb-6">
      <nav aria-label="Principal">
        <ul class="divide-y divide-line-soft">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-nav-link
                  class="group flex min-h-12 items-center justify-between gap-4 py-3 text-base font-medium text-ink"
                >
                  <span class="flex items-center gap-2.5">
                    {link.label}
                    <span class="hidden size-1.5 rounded-full bg-brand-500 group-aria-[current=true]:block" aria-hidden="true" />
                  </span>
                  <Icon
                    name="chevron-right"
                    class="size-4 text-muted transition-[color,translate] duration-200 group-hover:translate-x-0.5 group-hover:text-ink"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <Button href={startHref} size="lg" icon="whatsapp" class="w-full sm:w-auto">Empezar gratis en WhatsApp</Button>
        <p class="text-center text-sm text-muted">
          Escríbenos al <span class="tabular font-medium text-body">{SITE.whatsappDisplay}</span>
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('[data-navbar]');
  if (navbar) setupNavbar(navbar);

  function setupNavbar(header: HTMLElement) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-nav-panel]');
    const scrim = header.querySelector<HTMLElement>('[data-nav-scrim]');
    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 64rem)');

    // Hairline bottom border once the page leaves the top.
    let ticking = false;
    const syncScrolled = () => {
      ticking = false;
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(syncScrolled);
      },
      { passive: true },
    );
    syncScrolled();

    if (toggle && panel) {
      const layers = scrim ? [panel, scrim] : [panel];
      let hideTimer = 0;
      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

      const setOpen = (open: boolean, { focusToggle = false, instant = false } = {}) => {
        if (open === isOpen()) return;
        window.clearTimeout(hideTimer);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        header.toggleAttribute('data-open', open);
        panel.inert = !open;

        if (open) {
          layers.forEach((el) => (el.hidden = false));
          void panel.offsetHeight; // commit the closed styles so the enter transition runs
          layers.forEach((el) => el.setAttribute('data-state', 'open'));
          return;
        }

        layers.forEach((el) => el.removeAttribute('data-state'));
        const hide = () => layers.forEach((el) => (el.hidden = true));
        if (instant || reduceMotion.matches) hide();
        else hideTimer = window.setTimeout(hide, 200);
        if (focusToggle) toggle.focus();
      };

      toggle.addEventListener('click', () => setOpen(!isOpen()));

      panel.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setOpen(false);
      });

      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (isOpen() && !panel.contains(target) && !toggle.contains(target)) setOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) setOpen(false, { focusToggle: true });
      });

      header.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (isOpen() && next && !header.contains(next)) setOpen(false);
      });

      desktop.addEventListener('change', (event) => {
        if (event.matches) setOpen(false, { instant: true });
      });
    }

    // Scroll-spy: highlight the link whose section crosses a band near the top third.
    const sections = links
      .map((link) => link.getAttribute('href') ?? '')
      .filter((href, index, all) => href.startsWith('#') && all.indexOf(href) === index)
      .map((href) => document.getElementById(href.slice(1)))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length || !('IntersectionObserver' in window)) return;

    const inView = new Set<string>();
    const setCurrent = (id: string | undefined) => {
      links.forEach((link) => {
        if (id && link.getAttribute('href') === `#${id}`) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) inView.add(entry.target.id);
          else inView.delete(entry.target.id);
        });
        setCurrent(sections.find((section) => inView.has(section.id))?.id);
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
