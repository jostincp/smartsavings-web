        <span class="absolute inset-0 hidden bg-brand-500/10 group-data-[scanning=true]/photo:block"></span>
        <span class="absolute inset-x-0 hidden h-0.5 animate-scan bg-brand-400 group-data-[scanning=true]/photo:block"></span>
        <span class="absolute right-1.5 bottom-1 inline-flex items-center gap-1 rounded-full bg-black/35 px-1.5 text-[10.5px] text-white">
          <span data-time></span>
