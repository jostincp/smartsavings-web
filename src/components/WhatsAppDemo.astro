---
/**
 * Hero product demo: a WhatsApp chat where the user sends a voice note,
 * a receipt photo or a text, the AI extracts the expense and the user
 * confirms (or corrects) it. Driven by a small pause-aware timeline.
 */
import Icon, { type IconName } from './ui/Icon.astro';
import Logo from './ui/Logo.astro';

const uid = 'wa-demo';

const tabs: { id: string; icon: IconName; title: string; short: string; example: string }[] = [
  { id: 'voz', icon: 'mic', title: 'Nota de voz', short: 'Audio', example: '«Almorcé 18 mil en el corrientazo, pagué con Nequi»' },
  { id: 'foto', icon: 'camera', title: 'Foto del recibo', short: 'Foto', example: 'Recibo de Tiendas D1' },
  { id: 'texto', icon: 'type', title: 'Mensaje de texto', short: 'Texto', example: '«uber a la oficina 12.500»' },
];

const steps: { n: number; icon: IconName; label: string }[] = [
  { n: 1, icon: 'send', label: 'Envías' },
  { n: 2, icon: 'sparkles', label: 'La IA extrae' },
  { n: 3, icon: 'check-circle', label: 'Confirmas' },
];

const fields: { key: string; label: string; skeleton: string }[] = [
  { key: 'amount', label: 'Monto', skeleton: 'w-20' },
  { key: 'category', label: 'Categoría', skeleton: 'w-24' },
  { key: 'detail', label: 'Descripción', skeleton: 'w-28' },
  { key: 'method', label: 'Método de pago', skeleton: 'w-16' },
  { key: 'date', label: 'Fecha', skeleton: 'w-24' },
  { key: 'source', label: 'Fuente', skeleton: 'w-32' },
];

const receipt = [
  { item: 'Leche entera 1 L', price: '$4.900' },
  { item: 'Huevos x30', price: '$17.500' },
  { item: 'Pan tajado', price: '$6.200' },
  { item: 'Café molido 500 g', price: '$17.000' },
];

const wave = [30, 55, 80, 45, 95, 60, 35, 70, 100, 65, 40, 85, 50, 30, 75, 90, 45, 60, 35, 80, 55, 40, 70, 30, 50, 35];
const categoryIcons: IconName[] = ['utensils', 'shopping-cart', 'car'];

// Yesterday's 9:00 p. m. summary shown at the top of the chat (ends at the $800.000 starting balance).
const summary = [
  { label: 'Alimentación', value: '$32.000' },
  { label: 'Transporte', value: '$14.500' },
];
---

<div
  class="group/demo relative w-full"
  data-demo
  data-autoplay="true"
  data-frozen="true"
  data-static="false"
  role="region"
  aria-label="Demostración de SmartSavings en WhatsApp"
  aria-describedby={`${uid}-desc`}
>
  <p id={`${uid}-desc`} class="sr-only">
    Simulación de un chat: envías un gasto como nota de voz, foto del recibo o texto; la IA extrae monto, categoría,
    descripción, método de pago y fecha; y tú confirmas o corriges el registro.
    <span class="block group-data-[static=true]/demo:hidden">La demostración avanza sola y puedes pausarla.</span>
  </p>

  <div class="relative overflow-hidden rounded-3xl border border-line bg-canvas">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-grid mask-radial-fade"></div>

    <div
      class="relative grid gap-5 p-4 sm:p-6 md:grid-cols-[300px_minmax(0,1fr)] md:grid-rows-[auto_1fr] md:gap-x-8 md:gap-y-5 lg:p-8 xl:grid-cols-[minmax(0,1fr)_320px_minmax(0,1fr)] xl:grid-rows-1 xl:items-center"
    >
      <!-- Scenario selector -->
      <div class="flex min-w-0 flex-col md:col-start-2 md:row-start-1 xl:col-start-1">
        <p class="hidden font-mono text-[11px] tracking-wider text-muted uppercase xl:block">Elige un ejemplo</p>
        <div class="flex items-center gap-2 xl:mt-4 xl:flex-col xl:items-stretch xl:gap-0">
          <div
            role="tablist"
            aria-label="Formas de registrar un gasto"
            aria-orientation="horizontal"
            data-tablist
            class="flex min-w-0 flex-1 gap-1 rounded-full border border-line bg-line-soft/70 p-1 xl:flex-none xl:flex-col xl:gap-2 xl:rounded-none xl:border-0 xl:bg-transparent xl:p-0"
          >
            {
              tabs.map((tab, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`${uid}-tab-${tab.id}`}
                  data-tab={tab.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`${uid}-screen`}
                  tabindex={i === 0 ? 0 : -1}
                  class="group/tab relative flex h-10 min-w-0 flex-1 items-center justify-center gap-1.5 overflow-hidden rounded-full px-2 text-[13px] font-medium text-muted transition-[color,background-color,border-color,box-shadow] duration-200 hover:text-ink aria-selected:bg-surface aria-selected:text-ink aria-selected:shadow-card xl:h-auto xl:flex-none xl:justify-start xl:gap-3.5 xl:rounded-2xl xl:border xl:border-transparent xl:p-3.5 xl:text-left xl:hover:bg-surface/70 xl:aria-selected:border-ink/15 xl:aria-selected:bg-surface"
                >
                  <span class="inline-flex shrink-0 items-center justify-center xl:size-10 xl:rounded-xl xl:border xl:border-line xl:bg-canvas xl:text-muted xl:group-aria-selected/tab:bg-surface xl:group-aria-selected/tab:text-ink">
                    <Icon name={tab.icon} class="size-4 xl:size-[18px]" />
                  </span>
                  <span class="flex min-w-0 flex-col">
                    <span class="truncate xl:hidden">{tab.short}</span>
                    <span class="hidden text-[15px] tracking-[-0.01em] text-body group-aria-selected/tab:text-ink xl:block">
                      {tab.title}
                    </span>
                    <span class="mt-0.5 hidden truncate text-sm font-normal text-muted xl:block">{tab.example}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-x-5 bottom-[3px] h-0.5 overflow-hidden rounded-full opacity-0 group-aria-selected/tab:opacity-100 group-data-[autoplay=false]/demo:invisible xl:inset-x-0 xl:bottom-0 xl:rounded-none xl:bg-line-soft"
                  >
                    <span data-progress class="block h-full origin-left bg-ink/60 xl:bg-ink" style="transform: scaleX(0)"></span>
                  </span>
                </button>
              ))
            }
          </div>

          <div class="flex shrink-0 items-center gap-2 xl:mt-5">
            <button
              type="button"
              data-pause
              aria-label="Pausar demostración"
              class="inline-flex size-10 shrink-0 items-center justify-center gap-2 rounded-full border border-line bg-surface text-sm font-medium text-ink shadow-card transition-colors duration-200 hover:bg-canvas xl:w-auto xl:px-4"
            >
              <span data-ico-pause class="inline-flex"><Icon name="pause" class="size-4" /></span>
              <span data-ico-play class="inline-flex" hidden><Icon name="play" class="size-4" /></span>
              <span data-pause-text class="hidden xl:inline">Pausar</span>
            </button>
            <button
              type="button"
              data-repeat
              aria-label="Repetir ejemplo"
              class="hidden size-10 shrink-0 items-center justify-center gap-2 rounded-full text-sm font-medium text-body transition-colors duration-200 hover:bg-surface hover:text-ink sm:inline-flex xl:w-auto xl:px-4"
            >
              <Icon name="rotate-ccw" class="size-4" />
              <span class="hidden xl:inline">Repetir</span>
            </button>
          </div>
        </div>
        <p class="mt-5 hidden max-w-[17rem] gap-2 text-sm leading-relaxed text-muted xl:flex group-data-[static=true]/demo:hidden">
          <Icon name="info" class="mt-0.5 size-4 shrink-0" />
          <span>Toca <span class="font-medium text-ink">Confirmar</span> o <span class="font-medium text-ink">Editar</span> dentro del chat para probarlo tú.</span>
        </p>
      </div>

      <!-- Phone -->
      <div class="flex items-center justify-center md:col-start-1 md:row-span-2 md:row-start-1 xl:col-start-2 xl:row-span-1">
        <div class="w-full max-w-[320px] rounded-[2.75rem] bg-zinc-950 p-2.5 shadow-float ring-1 ring-black/10 md:max-w-none">
          <div
            id={`${uid}-screen`}
            role="tabpanel"
            aria-labelledby={`${uid}-tab-voz`}
            class="relative flex h-[560px] flex-col overflow-hidden rounded-[2.25rem] bg-wa-bg md:h-[600px] xl:h-[640px]"
          >
            <span aria-hidden="true" class="absolute top-2.5 left-1/2 z-20 h-[22px] w-[78px] -translate-x-1/2 rounded-full bg-zinc-950"></span>

            <div aria-hidden="true" class="flex h-10 shrink-0 items-center justify-between bg-white px-7 pt-1 text-[12.5px] font-semibold text-wa-text">
              <span data-clock class="tabular">12:40</span>
              <span class="flex items-center gap-1.5">
                <span class="flex items-end gap-[2px]">
                  <span class="h-1 w-[3px] rounded-[1px] bg-wa-text"></span>
                  <span class="h-1.5 w-[3px] rounded-[1px] bg-wa-text"></span>
                  <span class="h-2 w-[3px] rounded-[1px] bg-wa-text"></span>
                  <span class="h-2.5 w-[3px] rounded-[1px] bg-wa-text/30"></span>
                </span>
                <span class="relative flex h-[11px] w-[22px] items-center rounded-[3px] border border-wa-text/40 p-[1.5px]">
                  <span class="h-full w-3/4 rounded-[1.5px] bg-wa-text"></span>
                  <span class="absolute top-1/2 -right-[3.5px] h-1 w-[2px] -translate-y-1/2 rounded-r-sm bg-wa-text/40"></span>
                </span>
              </span>
            </div>

            <div class="flex shrink-0 items-center gap-2 border-b border-black/5 bg-white px-2.5 pt-1 pb-2">
              <Icon name="chevron-left" class="size-5 text-wa-header" />
              <Logo showWordmark={false} />
              <div class="min-w-0 flex-1 leading-tight">
                <p class="flex items-center gap-1 text-[14px] font-semibold text-wa-text">
                  SmartSavings
                  <span class="inline-flex size-3.5 items-center justify-center rounded-full bg-brand-500 text-white">
                    <Icon name="check" class="size-2.5" strokeWidth={3.5} />
                  </span>
                  <span class="sr-only">, cuenta verificada</span>
                </p>
                <p data-presence data-typing="false" class="text-[11.5px] text-wa-meta data-[typing=true]:text-wa-header">
                  en línea
                </p>
              </div>
              <Icon name="video" class="size-5 text-wa-header" />
              <Icon name="more-vertical" class="size-5 text-wa-header" />
            </div>

            <!-- The log is top-anchored and pinned to the bottom with a translate, so new messages don't count as layout shifts. -->
            <div class="relative min-h-0 flex-1 overflow-hidden [container-type:size]">
              <div
                data-log
                data-fading="false"
                role="log"
                aria-live="off"
                aria-label="Conversación de ejemplo"
                class="absolute inset-x-0 top-0 flex translate-y-[calc(100cqh_-_100%)] flex-col gap-1.5 px-3 pt-8 pb-3 transition-opacity duration-200 data-[fading=true]:pointer-events-none data-[fading=true]:opacity-0"
              >
                <p class="mx-auto mb-1 rounded-md bg-white/90 px-2.5 py-0.5 text-[11px] font-medium text-wa-meta shadow-card">Ayer</p>
                <div class="w-[86%] self-start rounded-lg rounded-tl-sm bg-wa-in px-2.5 py-2 text-[13px] leading-snug text-wa-text shadow-card">
                  <p class="flex items-center gap-1.5 font-medium">
                    <Icon name="bar-chart" class="size-4 text-brand-600" />
                    Tu resumen del día
                  </p>
                  <dl class="mt-1.5 space-y-0.5 text-[12px]">
                    {
                      summary.map((row) => (
                        <div class="flex justify-between gap-3">
                          <dt class="text-wa-meta">{row.label}</dt>
                          <dd class="tabular">{row.value}</dd>
                        </div>
                      ))
                    }
                    <div class="flex justify-between gap-3 border-t border-black/5 pt-0.5 font-medium">
                      <dt>Total</dt>
                      <dd class="tabular">$46.500</dd>
                    </div>
                  </dl>
                  <p class="mt-1.5 text-[12px] text-wa-meta">
                    Te quedan <span class="tabular font-semibold text-wa-text">$800.000</span> en tu quincena.
                  </p>
                  <p class="text-right text-[10.5px] text-wa-meta">9:00 p. m.</p>
                </div>
                <p class="mx-auto my-1 rounded-md bg-white/90 px-2.5 py-0.5 text-[11px] font-medium text-wa-meta shadow-card">Hoy</p>
              </div>
              <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-linear-to-b from-wa-bg to-transparent"></div>
            </div>

            <div aria-hidden="true" class="relative flex shrink-0 items-center gap-1.5 px-2 pt-1.5 pb-6">
              <div class="flex h-10 min-w-0 flex-1 items-center gap-2 rounded-full bg-white pr-3 pl-3.5 shadow-card">
                <div data-input-text class="flex min-w-0 flex-1 items-center overflow-hidden text-[13px] whitespace-nowrap">
                  <span data-ph class="text-wa-meta">Mensaje</span>
                  <span data-typed class="text-wa-text" hidden></span>
                  <span data-caret class="ml-px inline-block h-4 w-[1.5px] shrink-0 animate-caret bg-wa-header" hidden></span>
                  <span data-rec class="flex items-center gap-1.5 text-wa-text" hidden>
                    <span class="size-2 animate-pulse rounded-full bg-red-500"></span>
                    <span data-rec-time class="tabular">0:00</span>
                    <span class="text-wa-meta">Grabando…</span>
                  </span>
                </div>
                <span data-attach class="inline-flex items-center gap-2.5 text-wa-meta">
                  <Icon name="paperclip" class="size-[18px]" />
                  <span data-cam class="inline-flex transition-colors duration-200 data-[active=true]:text-wa-header">
                    <Icon name="camera" class="size-[18px]" />
                  </span>
                </span>
              </div>
              <span
                data-send-btn
                data-rec="false"
                class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-wa-teal text-white transition-transform duration-200 data-[rec=true]:scale-110"
              >
                <span data-ico-mic class="inline-flex"><Icon name="mic" class="size-[18px]" strokeWidth={2} /></span>
                <span data-ico-send class="inline-flex" hidden><Icon name="send" class="size-[17px]" strokeWidth={2} /></span>
              </span>
              <span class="absolute bottom-2 left-1/2 h-1 w-28 -translate-x-1/2 rounded-full bg-wa-text/80"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Extraction panel -->
      <div class="min-w-0 md:col-start-2 md:row-start-2 xl:col-start-3 xl:row-start-1">
        <div data-panel data-status="idle" class="group/panel flex h-full flex-col rounded-2xl border border-line bg-surface p-5 shadow-card">
          <div class="flex items-start gap-3">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl border border-line bg-canvas text-ink">
              <Icon name="sparkles" class="size-5" />
            </span>
            <div class="min-w-0">
              <p class="text-[15px] font-medium tracking-[-0.01em] text-ink">Datos extraídos</p>
              <p
                data-pill
                data-state="idle"
                aria-live="off"
                class="group/pill mt-1 inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-2 py-0.5 text-xs font-medium text-muted transition-colors duration-200 data-[state=processing]:text-ink data-[state=ready]:border-ink/15 data-[state=ready]:text-ink data-[state=saved]:border-brand-200 data-[state=saved]:bg-brand-50 data-[state=saved]:text-brand-700"
              >
                <span class="size-1.5 rounded-full bg-subtle group-data-[state=processing]/pill:animate-pulse-dot group-data-[state=processing]/pill:bg-brand-500 group-data-[state=ready]/pill:bg-ink group-data-[state=saved]/pill:bg-brand-500"></span>
                <span data-pill-text>Esperando mensaje</span>
              </p>
            </div>
          </div>

          <ol class="mt-5 grid grid-cols-3 rounded-xl border border-line-soft bg-canvas px-2 py-3" aria-label="Etapas">
            {
              steps.map((step, i) => (
                <li data-step data-state={i === 0 ? 'active' : 'pending'} class="group/step relative flex flex-col items-center gap-1.5 text-center">
                  {i < steps.length - 1 && (
                    <span
                      aria-hidden="true"
                      class="absolute top-3.5 right-[calc(-50%+20px)] left-[calc(50%+20px)] h-px bg-line transition-colors duration-300 group-data-[state=done]/step:bg-brand-500"
                    />
                  )}
                  <span class="relative inline-flex size-7 items-center justify-center rounded-full border border-line bg-surface text-subtle transition-colors duration-300 group-data-[state=active]/step:border-ink group-data-[state=active]/step:bg-ink group-data-[state=active]/step:text-white group-data-[state=done]/step:border-brand-500 group-data-[state=done]/step:bg-brand-500 group-data-[state=done]/step:text-white">
                    <Icon name={step.icon} class="size-3.5 group-data-[state=done]/step:hidden" />
                    <Icon name="check" class="hidden size-3.5 group-data-[state=done]/step:block" strokeWidth={2.5} />
                  </span>
                  <span class="text-[12px] leading-tight text-muted group-data-[state=active]/step:font-medium group-data-[state=active]/step:text-ink group-data-[state=done]/step:text-body">
                    <span class="font-mono text-[10.5px] text-muted">{step.n}</span>
                    {step.label}
                  </span>
                </li>
              ))
            }
          </ol>

          <dl class="mt-3 divide-y divide-line-soft">
            {
              fields.map((field) => (
                <div
                  data-field={field.key}
                  data-filled="false"
                  data-corrected="false"
                  class="group/row -mx-2 flex min-h-[42px] items-center justify-between gap-3 rounded-lg px-2 py-2 transition-colors duration-500 data-[corrected=true]:bg-brand-50"
                >
                  <dt class="flex shrink-0 items-center gap-1.5 font-mono text-[11px] tracking-wider text-muted uppercase">
                    <span data-label>{field.label}</span>
                    {field.key === 'amount' && (
                      <span class="hidden rounded-full bg-brand-100 px-1.5 py-px font-sans text-[10.5px] font-medium tracking-normal text-brand-800 normal-case group-data-[corrected=true]/row:inline-flex">
                        Corregido
                      </span>
                    )}
                  </dt>
                  <dd class="flex min-h-6.5 min-w-0 flex-1 items-center justify-end text-right">
                    <span
                      data-skel
                      class:list={[
                        'block h-2.5 rounded-full bg-line group-data-[status=processing]/panel:animate-pulse',
                        field.skeleton,
                      ]}
                    />
                    {field.key === 'category' ? (
                      <span data-val hidden class="inline-flex min-w-0 items-center gap-1.5 rounded-full border border-line bg-canvas py-0.5 pr-2.5 pl-1.5 text-[13px] text-ink">
                        <span data-val-icon class="inline-flex size-3.5 shrink-0 text-brand-600" />
                        <span data-val-text class="truncate" />
                      </span>
                    ) : (
                      <span data-val hidden class:list={['min-w-0', field.key === 'amount' ? 'text-[17px] font-semibold tracking-[-0.01em] text-ink' : 'text-sm text-ink']}>
                        <span data-val-text class="tabular" />
                      </span>
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div data-footer data-state="pending" class="group/foot mt-auto grid pt-4">
            <div class="col-start-1 row-start-1 flex items-start gap-2.5 rounded-xl border border-dashed border-line p-3.5 transition-opacity duration-300 group-data-[state=saved]/foot:invisible group-data-[state=saved]/foot:opacity-0">
              <Icon name="lock" class="mt-0.5 size-4 shrink-0 text-muted" />
              <div class="text-sm leading-relaxed">
                <p class="font-medium text-ink">Tú confirmas cada gasto</p>
                <p class="mt-0.5 text-muted">¿Algo no cuadra? Responde «eran 15 mil» y se corrige.</p>
              </div>
            </div>
            <div class="invisible col-start-1 row-start-1 rounded-xl border border-line bg-canvas p-3.5 opacity-0 transition-opacity duration-300 group-data-[state=saved]/foot:visible group-data-[state=saved]/foot:opacity-100">
              <p class="flex items-center gap-1.5 text-sm font-medium text-ink">
                <Icon name="check-circle" class="size-4 text-brand-600" />
                Guardado en tu historial
              </p>
              <p class="mt-2.5 flex items-baseline justify-between gap-3 text-sm">
                <span class="text-muted">Disponible de tu quincena</span>
                <span data-foot-avail class="tabular font-semibold text-ink">$800.000</span>
              </p>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line">
                <div data-foot-bar class="h-full w-0 rounded-full bg-brand-500 transition-[width] duration-700 ease-out-soft"></div>
              </div>
              <p data-foot-used class="mt-1.5 font-mono text-[11px] text-muted">50&nbsp;% usado de $1.600.000</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chat message templates (cloned by the script; text set with textContent) -->
  <template data-tpl="out-voice">
    <div data-playing="false" class="group/voice w-[80%] self-end rounded-lg rounded-tr-sm bg-wa-out px-2 pt-1.5 pb-1 shadow-card">
      <div class="flex items-center gap-2">
        <span class="inline-flex size-7 shrink-0 items-center justify-center text-wa-meta">
          <Icon name="play" class="size-4 fill-current group-data-[playing=true]/voice:hidden" />
          <Icon name="pause" class="hidden size-4 fill-current group-data-[playing=true]/voice:block" />
        </span>
        <span class="flex h-7 min-w-0 flex-1 items-center gap-[2px]">
          {
            wave.map((h, i) => (
              <span
                class="w-[2.5px] shrink-0 rounded-full bg-wa-meta/50 group-data-[playing=true]/voice:animate-wave group-data-[playing=true]/voice:bg-wa-header"
                style={`height: ${h}%; animation-delay: ${(i % 7) * 90}ms`}
              />
            ))
          }
        </span>
      </div>
      <div class="flex items-center justify-between pl-9 text-[10.5px] text-wa-meta">
        <span class="tabular">0:04</span>
        <span class="inline-flex items-center gap-1">
          <span data-time></span>
          <svg viewBox="0 0 16 11" class="h-[11px] w-4 text-wa-tick" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m1 5.8 2.9 2.8L9.6 1.6"></path><path d="m7.6 8.4.4.2 5.6-7"></path></svg>
        </span>
      </div>
      <p data-transcript class="mt-1 border-t border-black/5 pt-1 pb-0.5 text-[12px] leading-snug text-wa-text/80 italic" hidden></p>
    </div>
  </template>

  <template data-tpl="out-photo">
    <div data-scanning="false" class="group/photo w-[66%] self-end rounded-lg rounded-tr-sm bg-wa-out p-1 shadow-card">
      <div class="relative h-[168px] overflow-hidden rounded-md bg-stone-300">
        <div class="absolute top-3 left-1/2 w-[150px] -translate-x-1/2 -rotate-2 rounded-sm bg-white px-2.5 pt-2 pb-3 font-mono text-[8px] leading-[1.5] text-zinc-600 shadow-card">
          <p class="text-center text-[9.5px] font-semibold tracking-wide text-zinc-900">TIENDAS D1</p>
          <p class="text-center text-zinc-500">Factura de venta</p>
