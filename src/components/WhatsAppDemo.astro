  </template>

  <template data-tpl="out-text">
    <div class="flex max-w-[82%] flex-wrap items-end justify-end gap-x-2 self-end rounded-lg rounded-tr-sm bg-wa-out px-2.5 py-1.5 text-[13px] leading-snug text-wa-text shadow-card">
      <span data-text class="mr-auto"></span>
      <span class="inline-flex translate-y-0.5 items-center gap-1 text-[10.5px] text-wa-meta">
        <span data-time></span>
        <svg viewBox="0 0 16 11" class="h-[11px] w-4 text-wa-tick" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m1 5.8 2.9 2.8L9.6 1.6"></path><path d="m7.6 8.4.4.2 5.6-7"></path></svg>
      </span>
    </div>
  </template>

  <template data-tpl="in-text">
    <div class="flex max-w-[86%] flex-wrap items-end justify-end gap-x-2 self-start rounded-lg rounded-tl-sm bg-wa-in px-2.5 py-1.5 text-[13px] leading-snug text-wa-text shadow-card">
      <span data-text class="mr-auto"></span>
      <span data-time class="translate-y-0.5 text-[10.5px] text-wa-meta"></span>
    </div>
  </template>

  <template data-tpl="typing">
    <div class="flex items-center gap-1 self-start rounded-lg rounded-tl-sm bg-wa-in px-3 py-3 shadow-card" aria-hidden="true">
      <span class="size-1.5 animate-typing rounded-full bg-wa-meta"></span>
      <span class="size-1.5 animate-typing rounded-full bg-wa-meta [animation-delay:150ms]"></span>
      <span class="size-1.5 animate-typing rounded-full bg-wa-meta [animation-delay:300ms]"></span>
    </div>
  </template>

  <template data-tpl="card">
    <div class="w-[88%] self-start overflow-hidden rounded-lg rounded-tl-sm bg-wa-in text-wa-text shadow-card">
      <div class="px-3 pt-2.5 pb-1">
        <p class="flex items-center gap-1.5 text-[11.5px] font-medium text-wa-meta">
          <span data-card-icon class="inline-flex size-5 items-center justify-center rounded-md bg-brand-50 p-[3px] text-brand-700"></span>
          Gasto detectado
        </p>
        <p class="mt-1.5 flex items-center gap-2">
          <span data-amount class="tabular text-[22px] leading-none font-semibold tracking-[-0.02em]"></span>
          <span data-corrected class="rounded-full bg-brand-50 px-1.5 py-px text-[10.5px] font-medium text-brand-800" hidden>Corregido</span>
        </p>
        <dl class="mt-2 space-y-0.5 text-[12px] leading-snug">
          <div class="flex justify-between gap-3"><dt class="text-wa-meta">Categoría</dt><dd data-cat class="truncate text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt data-detail-label class="shrink-0 text-wa-meta"></dt><dd data-detail class="truncate text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-wa-meta">Método</dt><dd data-method class="truncate text-right"></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-wa-meta">Fecha</dt><dd data-date class="truncate text-right"></dd></div>
        </dl>
        <p data-time class="mt-1 text-right text-[10.5px] text-wa-meta"></p>
      </div>
      <button
        type="button"
        data-action="confirm"
        class="flex h-10 w-full items-center justify-center gap-1.5 border-t border-black/5 text-[13px] font-medium text-wa-header transition-colors duration-150 hover:bg-wa-panel data-[pressed=true]:bg-wa-panel aria-disabled:cursor-default aria-disabled:hover:bg-transparent data-[pressed=true]:aria-disabled:hover:bg-wa-panel [&[aria-disabled=true]:not([data-pressed=true])]:text-wa-meta"
      >
        <Icon name="check" class="size-4" strokeWidth={2.25} />
        Confirmar
      </button>
      <button
        type="button"
        data-action="edit"
        class="flex h-10 w-full items-center justify-center gap-1.5 border-t border-black/5 text-[13px] font-medium text-wa-header transition-colors duration-150 hover:bg-wa-panel data-[pressed=true]:bg-wa-panel aria-disabled:cursor-default aria-disabled:hover:bg-transparent data-[pressed=true]:aria-disabled:hover:bg-wa-panel [&[aria-disabled=true]:not([data-pressed=true])]:text-wa-meta"
      >
        <Icon name="pencil" class="size-3.5" strokeWidth={2} />
        Editar
      </button>
    </div>
  </template>

  <template data-tpl="saved">
    <div class="w-[88%] self-start rounded-lg rounded-tl-sm bg-wa-in px-2.5 py-2 text-[13px] leading-snug text-wa-text shadow-card">
      <p class="flex items-center gap-1.5 font-medium">
        <Icon name="check-circle" class="size-4 text-brand-600" />
        Listo, guardado.
      </p>
      <p class="mt-1 text-[12px] text-wa-meta">
        Disponible de tu quincena: <span data-avail class="tabular font-semibold text-wa-text"></span>
      </p>
      <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-wa-panel">
        <div data-bar class="h-full rounded-full bg-brand-500"></div>
      </div>
      <p class="mt-1 flex justify-between text-[10.5px] text-wa-meta">
        <span data-used class="tabular"></span>
        <span data-time></span>
      </p>
    </div>
  </template>

  {
    categoryIcons.map((name) => (
      <template data-tpl={`icon-${name}`}>
        <Icon name={name} class="size-full" />
      </template>
    ))
  }
</div>

<style is:global>
  /* Freeze CSS motion while the demo is paused or off-screen. */
  [data-demo][data-frozen='true'] * {
    animation-play-state: paused !important;
  }
</style>

<script>
  type Kind = 'voz' | 'foto' | 'texto';
  type FieldKey = 'amount' | 'category' | 'detail' | 'method' | 'date' | 'source';
  type Phase = 'compose' | 'processing' | 'awaiting' | 'confirming' | 'editing' | 'done';
  type Status = 'idle' | 'processing' | 'ready' | 'saved';
  type StepState = 'pending' | 'active' | 'done';
  type Tag = 'flow' | 'auto';

  interface Scenario {
    id: Kind;
    clock: string;
    time: string;
    amount: number;
    correctedAmount: number;
    correction: string;
    category: string;
    icon: 'utensils' | 'shopping-cart' | 'car';
    detailLabel: string;
    detail: string;
    method: string;
    source: string;
    message: string;
  }

  const SCENARIOS: readonly Scenario[] = [
    {
      id: 'voz',
      clock: '12:40',
      time: '12:40 p. m.',
      amount: 18000,
      correctedAmount: 15000,
      correction: 'eran 15 mil',
      category: 'Alimentación',
      icon: 'utensils',
      detailLabel: 'Descripción',
      detail: 'Almuerzo corrientazo',
      method: 'Nequi',
      source: 'Nota de voz · Whisper',
      message: '«Almorcé 18 mil en el corrientazo, pagué con Nequi»',
    },
    {
      id: 'foto',
      clock: '6:15',
      time: '6:15 p. m.',
      amount: 45600,
      correctedAmount: 44600,
      correction: 'eran 44.600',
      category: 'Mercado',
      icon: 'shopping-cart',
      detailLabel: 'Comercio',
      detail: 'Tiendas D1 · 4 productos',
      method: 'Tarjeta débito',
      source: 'Foto · Gemini 2.5 Flash',
      message: '',
    },
    {
      id: 'texto',
      clock: '8:05',
      time: '8:05 a. m.',
      amount: 12500,
      correctedAmount: 11800,
      correction: 'fueron 11.800',
      category: 'Transporte',
      icon: 'car',
      detailLabel: 'Descripción',
      detail: 'Uber a la oficina',
      method: 'Tarjeta de crédito',
      source: 'Texto · DeepSeek',
      message: 'uber a la oficina 12.500',
    },
  ];

  const FIELD_ORDER: readonly FieldKey[] = ['amount', 'category', 'detail', 'method', 'date', 'source'];
  const STATUS_TEXT: Record<Status, string> = {
    idle: 'Esperando mensaje',
    processing: 'Procesando…',
    ready: 'Listo para confirmar',
    saved: 'Guardado',
  };
  const BUDGET = 1_600_000;
  const START_AVAILABLE = 800_000;

  // Timing (ms). Sending → card is fixed; compose time depends on the scenario.
  const T = {
    fade: 220,
    typing: 600,
    firstField: 800,
    fieldStagger: 250,
    card: 2600,
    autoConfirm: 2300,
    autoConfirmAfterEdit: 3000,
    press: 260,
    saved: 1200,
    advance: 3000,
    resumeAdvance: 1200,
    char: 45,
  } as const;

  const money = (n: number) => '$' + Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');

  /** Single-timer scheduler on a virtual clock that can be frozen and resumed exactly. */
  class Timeline {
    private base = 0;
    private since = 0;
    private handle = 0;
    private tasks: { due: number; fn: () => void; tag: Tag }[] = [];
    running = false;

    now(): number {
      return this.running ? this.base + (performance.now() - this.since) : this.base;
    }

    start(): void {
      if (this.running) return;
      this.since = performance.now();
      this.running = true;
      this.arm();
    }

    stop(): void {
      if (!this.running) return;
      this.base = this.now();
      this.running = false;
      this.arm();
    }

    after(ms: number, fn: () => void, tag: Tag = 'flow'): void {
      const due = this.now() + ms;
      const index = this.tasks.findIndex((t) => t.due > due);
      const task = { due, fn, tag };
      if (index === -1) this.tasks.push(task);
      else this.tasks.splice(index, 0, task);
      this.arm();
    }

    cancel(tag?: Tag): void {
      this.tasks = tag ? this.tasks.filter((t) => t.tag !== tag) : [];
      this.arm();
    }

    private arm(): void {
      window.clearTimeout(this.handle);
      this.handle = 0;
      if (!this.running || this.tasks.length === 0) return;
      this.handle = window.setTimeout(this.flush, Math.max(0, this.tasks[0].due - this.now()));
    }

    private flush = (): void => {
      this.handle = 0;
      const now = this.now();
      while (this.running && this.tasks.length > 0 && this.tasks[0].due <= now) {
        this.tasks.shift()?.fn();
      }
      this.arm();
    };
  }

  function initDemo(root: HTMLElement): void {
    const one = <E extends Element = HTMLElement>(sel: string, scope: ParentNode = root) => scope.querySelector<E>(sel);
    const all = <E extends Element = HTMLElement>(sel: string, scope: ParentNode = root) =>
      Array.from(scope.querySelectorAll<E>(sel));

    const tablist = one('[data-tablist]');
    const tabs = all<HTMLButtonElement>('[role="tab"][data-tab]');
    const screen = one('[role="tabpanel"]');
    const log = one('[data-log]');
    const clockEl = one('[data-clock]');
    const presence = one('[data-presence]');
    const pauseBtn = one<HTMLButtonElement>('[data-pause]');
    const pauseText = one('[data-pause-text]');
    const icoPause = one('[data-ico-pause]');
    const icoPlay = one('[data-ico-play]');
    const repeatBtn = one<HTMLButtonElement>('[data-repeat]');
    const inputText = one('[data-input-text]');
    const ph = one('[data-ph]');
    const typed = one('[data-typed]');
    const caret = one('[data-caret]');
    const rec = one('[data-rec]');
    const recTime = one('[data-rec-time]');
    const attach = one('[data-attach]');
    const cam = one('[data-cam]');
    const sendBtn = one('[data-send-btn]');
    const icoMic = one('[data-ico-mic]');
    const icoSend = one('[data-ico-send]');
    const panel = one('[data-panel]');
    const pill = one('[data-pill]');
    const pillText = one('[data-pill-text]');
    const footer = one('[data-footer]');
    const footAvail = one('[data-foot-avail]');
    const footBar = one('[data-foot-bar]');
    const footUsed = one('[data-foot-used]');
    const stepEls = all('[data-step]');

    if (
      !tablist || !screen || !log || !clockEl || !presence || !pauseBtn || !pauseText || !icoPause || !icoPlay ||
      !repeatBtn || !inputText || !ph || !typed || !caret || !rec || !recTime || !attach || !cam || !sendBtn ||
      !icoMic || !icoSend || !panel || !pill || !pillText || !footer || !footAvail || !footBar || !footUsed ||
      tabs.length !== SCENARIOS.length || stepEls.length !== 3
    ) {
      return;
    }

    const templates = new Map<string, HTMLElement>();
    all<HTMLTemplateElement>('template[data-tpl]').forEach((tpl) => {
      const node = tpl.content.firstElementChild;
      if (node instanceof HTMLElement || node instanceof SVGElement) templates.set(tpl.dataset.tpl ?? '', node as HTMLElement);
    });
    const clone = (name: string): HTMLElement | null => {
      const node = templates.get(name);
      return node ? (node.cloneNode(true) as HTMLElement) : null;
    };
    const setText = (scope: ParentNode, sel: string, text: string) => {
      const el = scope.querySelector(sel);
      if (el) el.textContent = text;
    };

    const fieldEls = new Map<FieldKey, { row: HTMLElement; skel: HTMLElement; val: HTMLElement; text: HTMLElement; label: HTMLElement; icon: HTMLElement | null }>();
    for (const key of FIELD_ORDER) {
      const row = one(`[data-field="${key}"]`);
      const skel = row && one('[data-skel]', row);
      const val = row && one('[data-val]', row);
      const text = row && one('[data-val-text]', row);
      const label = row && one('[data-label]', row);
      if (!row || !skel || !val || !text || !label) return;
      fieldEls.set(key, { row, skel, val, text, label, icon: one('[data-val-icon]', row) });
    }

    const clock = new Timeline();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 80rem)');

    let staticMode = reduceMotion.matches;
    let autoplay = !staticMode;
    let frozen = false;
    let inView = false;
    let pageVisible = document.visibilityState === 'visible';
    let current = 0;
    let phase: Phase = 'compose';
    let scenarioStart = 0;
    let amountNow = SCENARIOS[0].amount;
    let edited = false;
    let typingNode: HTMLElement | null = null;
    let lastCard: HTMLElement | null = null;
    let hovering = false;
    let wasHeld = false;
    let barAnim: Animation | null = null;
    let progress: { start: number; frac: number; end: number | null } = { start: 0, frac: 0, end: null };

    const scenario = () => SCENARIOS[current];
    // Every scenario is its own chat that opens on yesterday's $800.000 balance.
    const available = () => START_AVAILABLE - amountNow;
    const usedPct = (avail: number) => Math.round(((BUDGET - avail) / BUDGET) * 100);

    // ---------- Progress bar on the active tab ----------
    const progressFrac = (): number => {
      if (progress.end === null) return progress.frac;
      const span = Math.max(1, progress.end - progress.start);
      return Math.min(1, progress.frac + (1 - progress.frac) * ((clock.now() - progress.start) / span));
    };
    const bars = tabs.map((tab) => one('[data-progress]', tab));
    /** Pins the bars at the current fill and, while running, lets the compositor fill the active one. */
    const drawProgress = () => {
      barAnim?.cancel();
      barAnim = null;
      const frac = progressFrac();
      bars.forEach((bar, i) => {
        if (bar) bar.style.transform = `scaleX(${i === current ? frac : 0})`;
      });
      const bar = bars[current];
      const left = progress.end === null ? 0 : progress.end - clock.now();
      if (bar && clock.running && autoplay && left > 0 && typeof bar.animate === 'function') {
        barAnim = bar.animate({ transform: [`scaleX(${frac})`, 'scaleX(1)'] }, { duration: left, easing: 'linear', fill: 'forwards' });
      }
    };
    const setProgressEnd = (end: number | null) => {
      progress = { start: clock.now(), frac: progressFrac(), end };
      drawProgress();
    };

    // ---------- Phone UI ----------
    const setPresence = (isTyping: boolean) => {
      presence.dataset.typing = String(isTyping);
      presence.textContent = isTyping ? 'escribiendo…' : 'en línea';
    };

    const setInput = (mode: 'idle' | 'typing' | 'rec', text = '') => {
      ph.hidden = mode !== 'idle';
      typed.hidden = mode !== 'typing';
      caret.hidden = mode !== 'typing';
      rec.hidden = mode !== 'rec';
      attach.hidden = mode === 'typing';
      typed.textContent = mode === 'typing' ? text : '';
      if (mode === 'rec') recTime.textContent = text;
      icoMic.hidden = mode === 'typing';
      icoSend.hidden = mode !== 'typing';
      sendBtn.dataset.rec = String(mode === 'rec');
      inputText.scrollLeft = inputText.scrollWidth;
    };

    const add = (node: HTMLElement, animate: boolean) => {
      node.dataset.msg = '';
      if (animate) node.classList.add('animate-pop-in');
      log.append(node);
      return node;
    };

    const clearLog = () => {
      all('[data-msg]', log).forEach((n) => n.remove());
      typingNode = null;
      lastCard = null;
    };

    const showTyping = () => {
      if (typingNode) return;
      const node = clone('typing');
      if (!node) return;
      typingNode = add(node, true);
      setPresence(true);
    };

    const hideTyping = () => {
      typingNode?.remove();
      typingNode = null;
      setPresence(false);
    };

    const appendOutText = (text: string, animate = true) => {
      const node = clone('out-text');
      if (!node) return null;
      setText(node, '[data-text]', text);
      setText(node, '[data-time]', scenario().time);
      return add(node, animate);
    };

    const appendInText = (text: string, animate = true) => {
      const node = clone('in-text');
      if (!node) return null;
      setText(node, '[data-text]', text);
      setText(node, '[data-time]', scenario().time);
      return add(node, animate);
    };

    const appendUserMessage = (s: Scenario, animate: boolean) => {
      if (s.id === 'texto') return appendOutText(s.message, animate);
      const node = clone(s.id === 'voz' ? 'out-voice' : 'out-photo');
      if (!node) return null;
      setText(node, '[data-time]', s.time);
      const transcript = one('[data-transcript]', node);
      if (transcript) {
        transcript.textContent = s.message;
        transcript.hidden = animate;
      }
      return add(node, animate);
    };

    const iconFor = (s: Scenario) => clone(`icon-${s.icon}`);

    /** Retires the card buttons; the focused one stays focusable (aria-disabled) so keyboard focus isn't lost. */
    const disableCardButtons = () => {
      all<HTMLButtonElement>('button[data-action]', log).forEach((b) => {
        b.setAttribute('aria-disabled', 'true');
        b.disabled = b !== document.activeElement;
      });
    };

    const appendCard = (s: Scenario, amount: number, corrected: boolean, animate: boolean) => {
      const node = clone('card');
      if (!node) return null;
      disableCardButtons();
      const icon = iconFor(s);
      if (icon) one('[data-card-icon]', node)?.append(icon);
      setText(node, '[data-amount]', money(amount));
      const tag = one('[data-corrected]', node);
      if (tag) tag.hidden = !corrected;
      if (corrected) one('[data-action="edit"]', node)?.remove();
      setText(node, '[data-cat]', s.category);
      setText(node, '[data-detail-label]', s.detailLabel);
      setText(node, '[data-detail]', s.detail);
      setText(node, '[data-method]', s.method);
      setText(node, '[data-date]', `Hoy, ${s.time}`);
      setText(node, '[data-time]', s.time);
      lastCard = add(node, animate);
      return lastCard;
    };

    const appendSaved = (s: Scenario, animate: boolean) => {
      const node = clone('saved');
      if (!node) return;
      const avail = available();
      setText(node, '[data-avail]', money(avail));
      setText(node, '[data-used]', `${usedPct(avail)}\u00a0% usado`);
      setText(node, '[data-time]', s.time);
      const bar = one('[data-bar]', node);
      if (bar) bar.style.width = `${usedPct(avail)}%`;
      add(node, animate);
    };

    // ---------- Extraction panel ----------
    const setStatus = (status: Status) => {
      panel.dataset.status = status;
      pill.dataset.state = status;
      pillText.textContent = STATUS_TEXT[status];
    };

    const setSteps = (states: [StepState, StepState, StepState]) => {
      stepEls.forEach((el, i) => (el.dataset.state = states[i]));
    };

    const replay = (el: HTMLElement) => {
      el.classList.remove('animate-pop-in');
      void el.offsetWidth;
      el.classList.add('animate-pop-in');
    };

    const clearField = (key: FieldKey) => {
      const f = fieldEls.get(key);
      if (!f) return;
      f.row.dataset.filled = 'false';
      f.skel.hidden = false;
      f.val.hidden = true;
      f.text.textContent = '';
      f.icon?.replaceChildren();
    };

    const fillField = (key: FieldKey, s: Scenario, animate: boolean) => {
      const f = fieldEls.get(key);
      if (!f) return;
      const values: Record<FieldKey, string> = {
        amount: money(amountNow),
        category: s.category,
        detail: s.detail,
        method: s.method,
        date: `Hoy, ${s.time}`,
        source: s.source,
      };
      f.text.textContent = values[key];
      if (f.icon) {
        const icon = iconFor(s);
        f.icon.replaceChildren(...(icon ? [icon] : []));
      }
      f.row.dataset.filled = 'true';
      f.skel.hidden = true;
      f.val.hidden = false;
      if (animate) replay(f.val);
    };

    const setFooter = (saved: boolean) => {
      footer.dataset.state = saved ? 'saved' : 'pending';
      const avail = available();
      footAvail.textContent = money(avail);
      footUsed.textContent = `${usedPct(avail)}\u00a0% usado de ${money(BUDGET)}`;
      footBar.style.width = saved ? `${usedPct(avail)}%` : '0%';
    };

    const resetPanel = (s: Scenario) => {
      setStatus('idle');
      setSteps(['active', 'pending', 'pending']);
      FIELD_ORDER.forEach(clearField);
      fieldEls.forEach((f) => (f.row.dataset.corrected = 'false'));
      const detail = fieldEls.get('detail');
      if (detail) detail.label.textContent = s.detailLabel;
      setFooter(false);
    };

    // ---------- Flow ----------
    const select = (i: number) => {
      current = i;
      tabs.forEach((tab, k) => {
        tab.setAttribute('aria-selected', String(k === i));
        tab.tabIndex = k === i ? 0 : -1;
      });
      screen.setAttribute('aria-labelledby', tabs[i].id);
      clockEl.textContent = SCENARIOS[i].clock;
      progress = { start: clock.now(), frac: 0, end: null };
      drawProgress();
    };

    const composeDuration = (s: Scenario) => {
      if (s.id === 'voz') return 250 + 4 * 330 + 150;
      if (s.id === 'foto') return 1100;
      return 300 + s.message.length * T.char + 250;
    };

    const autoTotal = (s: Scenario) => composeDuration(s) + T.card + T.autoConfirm + T.press + T.saved + T.advance;

    const typeInto = (text: string, startAt: number) => {
      for (let k = 1; k <= text.length; k++) {
        clock.after(startAt + k * T.char, () => setInput('typing', text.slice(0, k)));
      }
      return startAt + text.length * T.char;
    };

    /** Autoplay waits while the pointer or keyboard focus is on the phone. */
    const held = () => hovering || screen.querySelector(':focus-visible') !== null;

    /** Drops pending autoplay steps, including an auto-press of Confirmar that hasn't confirmed yet. */
    const cancelAuto = () => {
      clock.cancel('auto');
      if (phase === 'awaiting') lastCard?.querySelector('[data-action="confirm"]')?.removeAttribute('data-pressed');
    };

    /** Schedules the autoplay step for the current phase (auto-confirm or advance). */
    const scheduleAuto = (resumed = false) => {
      if (!autoplay || staticMode) return;
      cancelAuto();
      if (held() || phase === 'editing' || phase === 'confirming') {
        setProgressEnd(null);
      } else if (phase === 'awaiting') {
        const wait = edited ? T.autoConfirmAfterEdit : T.autoConfirm;
        clock.after(wait, pressConfirm, 'auto');
        setProgressEnd(clock.now() + wait + T.press + T.saved + T.advance);
      } else if (phase === 'done') {
        const wait = resumed ? T.resumeAdvance : T.advance;
        clock.after(wait, () => play((current + 1) % SCENARIOS.length), 'auto');
        setProgressEnd(clock.now() + wait);
      } else {
        setProgressEnd(scenarioStart + autoTotal(scenario()));
      }
    };

    const awaiting = () => {
      phase = 'awaiting';
      setStatus('ready');
      setSteps(['done', 'done', 'active']);
      scheduleAuto();
    };

    const pressConfirm = () => {
      const btn = lastCard ? one<HTMLButtonElement>('button[data-action="confirm"]', lastCard) : null;
      if (btn) btn.dataset.pressed = 'true';
      clock.after(T.press, confirm, 'auto');
    };

    const confirm = () => {
      clock.cancel('auto');
      phase = 'confirming';
      const btn = lastCard ? one<HTMLButtonElement>('button[data-action="confirm"]', lastCard) : null;
      if (btn) btn.dataset.pressed = 'true';
      disableCardButtons();
      appendOutText('Confirmar');
      clock.after(450, showTyping);
      clock.after(T.saved, () => {
        hideTyping();
        appendSaved(scenario(), true);
        setStatus('saved');
        setSteps(['done', 'done', 'done']);
        setFooter(true);
        phase = 'done';
        scheduleAuto();
      });
    };

    const edit = () => {
      const s = scenario();
      cancelAuto();
      phase = 'editing';
      edited = true;
      setProgressEnd(null);
      const btn = lastCard ? one<HTMLButtonElement>('button[data-action="edit"]', lastCard) : null;
      if (btn) btn.dataset.pressed = 'true';
      disableCardButtons();
      appendOutText('Editar');
      clock.after(450, showTyping);
      clock.after(1050, () => {
        hideTyping();
        appendInText('¿Qué quieres corregir?');
      });
      const sendAt = typeInto(s.correction, 1500) + 250;
      clock.after(sendAt, () => {
        setInput('idle');
        appendOutText(s.correction);
        setStatus('processing');
        setSteps(['done', 'active', 'pending']);
        clearField('amount');
      });
      clock.after(sendAt + 500, showTyping);
      clock.after(sendAt + 900, () => {
        amountNow = s.correctedAmount;
        fillField('amount', s, true);
        const row = fieldEls.get('amount')?.row;
        if (row) row.dataset.corrected = 'true';
      });
      clock.after(sendAt + 1400, () => {
        hideTyping();
        appendCard(s, amountNow, true, true);
        awaiting();
      });
    };

    const send = (s: Scenario) => {
      setInput('idle');
      cam.dataset.active = 'false';
      const msg = appendUserMessage(s, true);
      phase = 'processing';
      setStatus('processing');
      setSteps(['done', 'active', 'pending']);
      if (msg && s.id === 'voz') {
        msg.dataset.playing = 'true';
        clock.after(700, () => {
          const transcript = one('[data-transcript]', msg);
          if (transcript) {
            transcript.hidden = false;
            replay(transcript);
          }
        });
        clock.after(1500, () => (msg.dataset.playing = 'false'));
      }
      if (msg && s.id === 'foto') msg.dataset.scanning = 'true';
      clock.after(T.typing, showTyping);
      FIELD_ORDER.forEach((key, k) => clock.after(T.firstField + k * T.fieldStagger, () => fillField(key, s, true)));
      clock.after(T.card, () => {
        hideTyping();
        if (msg) msg.dataset.scanning = 'false';
        appendCard(s, s.amount, false, true);
        awaiting();
      });
    };

    const compose = (s: Scenario) => {
      if (s.id === 'voz') {
        clock.after(250, () => setInput('rec', '0:00'));
        for (let k = 1; k <= 4; k++) clock.after(250 + k * 330, () => setInput('rec', `0:0${k}`));
      } else if (s.id === 'foto') {
        clock.after(300, () => (cam.dataset.active = 'true'));
      } else {
        typeInto(s.message, 300);
      }
      clock.after(composeDuration(s), () => send(s));
    };

    const renderFinal = (i: number) => {
      clock.cancel();
      select(i);
      const s = scenario();
      amountNow = s.amount;
      clearLog();
      log.dataset.fading = 'false';
      resetPanel(s);
      setInput('idle');
      setPresence(false);
      cam.dataset.active = 'false';
      appendUserMessage(s, false);
      FIELD_ORDER.forEach((key) => fillField(key, s, false));
      appendCard(s, s.amount, false, false);
      const btn = lastCard ? one<HTMLButtonElement>('button[data-action="confirm"]', lastCard) : null;
      if (btn) btn.dataset.pressed = 'true';
      disableCardButtons();
      appendOutText('Confirmar', false);
      appendSaved(s, false);
      setStatus('saved');
      setSteps(['done', 'done', 'done']);
      setFooter(true);
      phase = 'done';
    };

    function play(i: number): void {
      if (staticMode) {
        renderFinal(i);
        return;
      }
      clock.cancel();
      select(i);
      const s = scenario();
      phase = 'compose';
      disableCardButtons();
      edited = false;
      amountNow = s.amount;
      scenarioStart = clock.now();
      resetPanel(s);
      setInput('idle');
      setPresence(false);
      cam.dataset.active = 'false';
      scheduleAuto();
      const hasMessages = log.querySelector('[data-msg]') !== null;
      if (hasMessages) log.dataset.fading = 'true';
      clock.after(hasMessages ? T.fade : 0, () => {
        clearLog();
        log.dataset.fading = 'false';
        compose(s);
      });
    }

    // ---------- Run state ----------
    const update = () => {
      const run = !staticMode && !frozen && inView && pageVisible;
      if (run) clock.start();
      else clock.stop();
      root.dataset.frozen = String(!run);
      root.dataset.autoplay = String(autoplay);
      root.dataset.static = String(staticMode);
      pauseBtn.hidden = staticMode;
      repeatBtn.hidden = staticMode;
      pauseBtn.setAttribute('aria-label', autoplay ? 'Pausar demostración' : 'Reanudar demostración');
      pauseText.textContent = autoplay ? 'Pausar' : 'Reanudar';
      icoPause.hidden = !autoplay;
      icoPlay.hidden = autoplay;
      pill.setAttribute('aria-live', autoplay ? 'off' : 'polite');
      tablist.setAttribute('aria-orientation', wide.matches ? 'vertical' : 'horizontal');
      drawProgress();
    };

    const activateTab = (i: number) => {
      frozen = false;
      play(i);
      update();
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => activateTab(i)));

    tablist.addEventListener('keydown', (event) => {
      const moves: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
      let next: number | null = null;
      const focused = tabs.findIndex((tab) => tab === document.activeElement);
      const from = focused === -1 ? current : focused;
      if (event.key in moves) next = (from + moves[event.key] + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      if (next === null) return;
      event.preventDefault();
      tabs[next].focus();
      activateTab(next);
    });

    pauseBtn.addEventListener('click', () => {
      if (autoplay) {
        autoplay = false;
        frozen = true;
        cancelAuto();
      } else {
        autoplay = true;
        frozen = false;
        scheduleAuto(true);
      }
      update();
    });

    repeatBtn.addEventListener('click', () => activateTab(current));

    log.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const btn = target?.closest<HTMLButtonElement>('button[data-action]');
      if (!btn || btn.getAttribute('aria-disabled') === 'true' || staticMode || phase !== 'awaiting') return;
      frozen = false;
      if (btn.dataset.action === 'edit') edit();
      else confirm();
      update();
    });

    const syncHold = () => {
      if (held() === wasHeld) return;
      wasHeld = !wasHeld;
      scheduleAuto(true);
    };
    screen.addEventListener('pointerenter', () => {
      hovering = true;
      syncHold();
    });
    screen.addEventListener('pointerleave', () => {
      hovering = false;
      syncHold();
    });
    screen.addEventListener('focusin', syncHold);
    screen.addEventListener('focusout', syncHold);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          inView = entries.some((e) => e.isIntersecting);
          update();
        },
        { threshold: 0.2 },
      ).observe(root);
    } else {
      inView = true;
    }

    document.addEventListener('visibilitychange', () => {
      pageVisible = document.visibilityState === 'visible';
      update();
    });

    wide.addEventListener('change', update);

    reduceMotion.addEventListener('change', () => {
      staticMode = reduceMotion.matches;
      autoplay = !staticMode;
      frozen = false;
      play(current);
      update();
    });

    play(0);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach(initDemo);
</script>
