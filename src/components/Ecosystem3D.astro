---
// Ecosystem3D.astro
---

<section id="ecosistema-3d" class="py-28 bg-[#F6FAFC] relative overflow-hidden">
  
  <!-- Subtle glowing radial backdrop -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[1000px] bg-[radial-gradient(circle,rgba(107,165,200,0.1)_0%,rgba(127,189,163,0.08)_35%,transparent_70%)] rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-[#6BA5C8]/40 shadow-xs text-xs font-bold text-[#2C4A5E]">
        <span class="w-2 h-2 rounded-full bg-[#6BA5C8]"></span>
        <span>ARQUITECTURA MULTI-AGENTE</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#2C4A5E] tracking-tight">
        El Ecosistema 3D de <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#6BA5C8] via-[#4A8EB8] to-[#7FBDA3]">SmartSavings</span>
      </h2>
      <p class="text-base sm:text-lg text-[#4A5568]">
        Inspirado en cómo fluye tu dinero: 4 pilares autónomos interconectados que procesan tus ingresos, gastos, presupuestos y reportes sin esfuerzo humano.
      </p>
    </div>

    <!-- 3D Ecosystem Interactive Stage -->
    <div class="relative py-8">
      
      <!-- SVG Glowing Circuit Conduits (Desktop Connection Lines) -->
      <svg class="hidden lg:block absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1200 600" fill="none">
        <defs>
          <linearGradient id="flowGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#6BA5C8" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#7FBDA3" stop-opacity="0.8" />
          </linearGradient>
          <linearGradient id="flowGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#7FBDA3" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#25D366" stop-opacity="0.8" />
          </linearGradient>
        </defs>

        <!-- Path Top-Left to Center -->
        <path d="M 360 160 C 480 160, 520 280, 600 280" stroke="url(#flowGrad1)" stroke-width="3" stroke-linecap="round" class="animate-dash-flow opacity-60" />
        
        <!-- Path Top-Right to Center -->
        <path d="M 840 160 C 720 160, 680 280, 600 280" stroke="url(#flowGrad1)" stroke-width="3" stroke-linecap="round" class="animate-dash-flow opacity-60" />

        <!-- Path Bottom-Left to Center -->
        <path d="M 360 440 C 480 440, 520 320, 600 320" stroke="url(#flowGrad1)" stroke-width="3" stroke-linecap="round" class="animate-dash-flow opacity-60" />

        <!-- Path Bottom-Right to Center -->
        <path d="M 840 440 C 720 440, 680 320, 600 320" stroke="url(#flowGrad1)" stroke-width="3" stroke-linecap="round" class="animate-dash-flow opacity-60" />

        <!-- Center Down to WhatsApp -->
        <path d="M 600 360 L 600 520" stroke="url(#flowGrad2)" stroke-width="3" stroke-linecap="round" class="animate-dash-flow opacity-70" />
      </svg>

      <!-- Center Mascot Node (Hub) -->
      <div class="relative z-10 flex flex-col items-center justify-center my-6 lg:my-0 lg:absolute lg:left-1/2 lg:top-1/2 lg:-translate-x-1/2 lg:-translate-y-1/2">
        <div class="relative group cursor-pointer">
          <!-- Ambient glowing orb -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-[#6BA5C8]/40 via-[#7FBDA3]/35 to-[#D4A574]/40 blur-2xl scale-125 animate-pulse-glow"></div>
          
          <!-- Central 3D Mascot Avatar Circle -->
          <div class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-gradient-to-br from-white via-[#F5F9FA] to-[#E2EFF6] p-2 shadow-2xl shadow-[#2C4A5E]/20 border-4 border-white flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
            <img src="/logo.svg" alt="SmartSavings Mascot Core" class="w-28 h-28 sm:w-32 sm:h-32 object-contain drop-shadow-md animate-float-slow" />
            
            <!-- Central Golden Coin Badge on Hub -->
            <div class="absolute -top-2 right-2 w-9 h-9 rounded-full bg-gradient-to-tr from-[#D4A574] to-[#F5B041] border-2 border-white flex items-center justify-center shadow-md animate-coin-bob">
              <span class="text-white font-extrabold text-sm">$</span>
            </div>
          </div>
        </div>

        <div class="mt-3 text-center">
          <span class="inline-block px-3 py-1 rounded-full bg-white/90 shadow-xs border border-[#6BA5C8]/30 text-xs font-bold text-[#2C4A5E]">
            SmartSavings Hub
          </span>
        </div>
      </div>

      <!-- 4 Pillars Grid (Responsive layout) -->
      <div class="grid md:grid-cols-2 gap-8 lg:gap-y-36 lg:gap-x-72 relative z-10">
        
        <!-- CARD 1: Gestión de Ingresos (Top-Left) -->
        <div class="glass-panel rounded-3xl p-6 sm:p-7 shadow-xl border border-white hover:shadow-2xl transition-all card-3d-tilt group">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-emerald-100/80 flex items-center justify-center text-2xl shadow-xs group-hover:scale-110 transition-transform">
                💼
              </div>
              <div>
                <h3 class="text-lg font-bold text-[#2C4A5E]">Gestión de Ingresos</h3>
                <span class="text-xs text-[#7FBDA3] font-semibold">Flujo de entrada transparente</span>
              </div>
            </div>
            <span class="text-xs font-bold text-slate-400">01</span>
          </div>

          <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed mb-4">
            Registra salarios fijos, honorarios freelance, ventas extraordinarias y remesas. SmartSavings calcula tu ingreso neto real.
          </p>

          <!-- Mock UI inside Card -->
          <div class="bg-white/80 rounded-2xl p-3.5 border border-slate-100 space-y-2.5">
            <div class="flex justify-between items-center text-xs">
              <span class="text-[#2C4A5E] font-medium">Salario Quincenal:</span>
              <span class="font-bold text-[#2ECC71]">+$2.850.000 COP</span>
            </div>
            <div class="flex justify-between items-center text-xs">
              <span class="text-[#2C4A5E] font-medium">Proyecto Freelance:</span>
              <span class="font-bold text-[#2ECC71]">+$920.000 COP</span>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500">Progreso meta mensual:</span>
              <span class="font-bold text-[#6BA5C8]">75%</span>
            </div>
          </div>
        </div>

        <!-- CARD 2: Control de Gastos & OCR (Top-Right) -->
        <div class="glass-panel rounded-3xl p-6 sm:p-7 shadow-xl border border-white hover:shadow-2xl transition-all card-3d-tilt group">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-blue-100/80 flex items-center justify-center text-2xl shadow-xs group-hover:scale-110 transition-transform">
                💳
              </div>
              <div>
                <h3 class="text-lg font-bold text-[#2C4A5E]">Control de Gastos & OCR</h3>
                <span class="text-xs text-[#6BA5C8] font-semibold">DeepSeek + Gemini 2.5 Flash</span>
              </div>
            </div>
            <span class="text-xs font-bold text-slate-400">02</span>
          </div>

          <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed mb-4">
            Toma la foto a tu factura o envía un audio rápido. La IA extrae los montos exactos y categoriza en segundos sin llenar formularios.
          </p>

          <!-- Mock UI inside Card -->
          <div class="bg-white/80 rounded-2xl p-3.5 border border-slate-100 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="flex items-center gap-1.5 text-[#2C4A5E]">
                <span>☕</span> Café Juan Valdez
              </span>
              <span class="font-bold text-[#E74C3C]">-$8.500 COP</span>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span class="flex items-center gap-1.5 text-[#2C4A5E]">
                <span>🎬</span> Suscripción Netflix
              </span>
              <span class="font-bold text-[#E74C3C]">-$38.900 COP</span>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span class="flex items-center gap-1.5 text-[#2C4A5E]">
                <span>🧾</span> Factura D1 (4 ítems)
              </span>
              <span class="font-bold text-[#E74C3C]">-$45.600 COP</span>
            </div>
          </div>
        </div>

        <!-- CARD 3: Presupuestos Inteligentes & Cierres (Bottom-Left) -->
        <div class="glass-panel rounded-3xl p-6 sm:p-7 shadow-xl border border-white hover:shadow-2xl transition-all card-3d-tilt group">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-amber-100/80 flex items-center justify-center text-2xl shadow-xs group-hover:scale-110 transition-transform">
                🎯
              </div>
              <div>
                <h3 class="text-lg font-bold text-[#2C4A5E]">Presupuestos & Cierres</h3>
                <span class="text-xs text-[#D4A574] font-semibold">Recordatorios 2:00 PM y 8:00 PM</span>
              </div>
            </div>
            <span class="text-xs font-bold text-slate-400">03</span>
          </div>

          <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed mb-4">
            El bot te empuja suavemente a registrar tus gastos del mediodía y la noche para que ningún gasto hormiga pase desapercibido.
          </p>

          <!-- Mock UI inside Card -->
          <div class="bg-white/80 rounded-2xl p-3.5 border border-slate-100 space-y-2.5">
            <div class="flex justify-between items-center text-xs">
              <span class="font-semibold text-[#2C4A5E]">Meta de Ahorro Quincenal:</span>
              <span class="font-bold text-[#D4A574]">$500.000 COP</span>
            </div>
            <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-[#D4A574] to-[#F5B041] rounded-full w-[84%]"></div>
            </div>
            <div class="text-[11px] text-slate-500 flex justify-between">
              <span>84% del objetivo asegurado</span>
              <span class="text-[#2ECC71] font-semibold">✓ En verde</span>
            </div>
          </div>
        </div>

        <!-- CARD 4: Reportes Visuales & Detección de Fuga (Bottom-Right) -->
        <div class="glass-panel rounded-3xl p-6 sm:p-7 shadow-xl border border-white hover:shadow-2xl transition-all card-3d-tilt group">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-2xl bg-teal-100/80 flex items-center justify-center text-2xl shadow-xs group-hover:scale-110 transition-transform">
                📊
              </div>
              <div>
                <h3 class="text-lg font-bold text-[#2C4A5E]">Reportes & Detección de Fuga</h3>
                <span class="text-xs text-[#7FBDA3] font-semibold">Resumen diario a las 9:00 PM</span>
              </div>
            </div>
            <span class="text-xs font-bold text-slate-400">04</span>
          </div>

          <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed mb-4">
            Recibe cada noche un balance total con gráficos y desglose por categorías canónicas (Alimentación, Transporte, Servicios, Viajes, etc.).
          </p>

          <!-- Mock UI inside Card -->
          <div class="bg-white/80 rounded-2xl p-3.5 border border-slate-100 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="text-[#2C4A5E] font-medium">Gasto Total Hoy:</span>
              <span class="font-bold text-[#2C4A5E]">$42.800 COP</span>
            </div>
            <div class="flex items-center justify-between text-xs">
              <span class="text-[#2C4A5E] font-medium">Mayor fuga del día:</span>
              <span class="font-bold text-[#E74C3C]">Alimentación (58%)</span>
            </div>
            <div class="pt-2 border-t border-slate-100 text-[11px] text-[#7FBDA3] font-semibold">
              ✓ Comparado con tu promedio: -12% de gasto
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>

</section>
