---
// SavingsCalculator.astro
---

<section id="calculadora" class="py-24 bg-gradient-to-b from-[#F6FAFC] via-[#EDF5F8] to-[#F6FAFC] relative overflow-hidden">
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-[#D4A574]/40 shadow-xs text-xs font-bold text-[#2C4A5E]">
        <span class="w-2 h-2 rounded-full bg-[#D4A574]"></span>
        <span>CALCULADORA DE FUGA QUINCENAL</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#2C4A5E] tracking-tight">
        ¿Cuánto dinero estás perdiendo <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4A574] via-[#E74C3C] to-[#2C4A5E]">sin darte cuenta</span>?
      </h2>
      <p class="text-base sm:text-lg text-[#4A5568]">
        El 82% de las personas pierden entre el 15% y el 25% de sus ingresos cada quincena en gastos invisibles no registrados. Mira cuánto rescatarías con SmartSavings:
      </p>
    </div>

    <!-- Interactive Calculator Card -->
    <div class="glass-panel rounded-3xl p-6 sm:p-10 shadow-2xl border border-white max-w-4xl mx-auto">
      
      <!-- Slider Control -->
      <div class="space-y-4 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <label for="incomeSlider" class="text-sm sm:text-base font-bold text-[#2C4A5E]">
            Tu Ingreso Mensual Aproximado:
          </label>
          <div class="flex items-center gap-1.5 bg-white px-4 py-2 rounded-2xl border border-slate-200 shadow-xs">
            <span class="text-xs font-semibold text-slate-400">COP</span>
            <span id="incomeDisplay" class="text-xl sm:text-2xl font-black text-[#2C4A5E]">$4,000,000</span>
          </div>
        </div>

        <input 
          type="range" 
          id="incomeSlider" 
          min="1500000" 
          max="12000000" 
          step="250000" 
          value="4000000"
          class="w-full h-3 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-[#6BA5C8]"
        />

        <div class="flex justify-between text-[11px] text-[#4A5568] font-medium px-1">
          <span>$1.500.000 COP</span>
          <span>$6.000.000 COP</span>
          <span>$12.000.000 COP</span>
        </div>
      </div>

      <!-- Calculation Results Grid -->
      <div class="grid sm:grid-cols-3 gap-6 pt-6 border-t border-slate-100">
        
        <!-- Fuga invisible mensual -->
        <div class="bg-red-50/70 rounded-2xl p-5 border border-red-100 text-center sm:text-left space-y-1">
          <div class="text-xs font-bold text-red-700 uppercase tracking-wider flex items-center justify-center sm:justify-start gap-1">
            <span>⚠️</span> Fuga Invisible (20%)
          </div>
          <div id="monthlyLeakDisplay" class="text-2xl sm:text-3xl font-black text-red-600">
            $800,000
          </div>
          <p class="text-[11px] text-red-500/90 leading-tight">
            Dinero que se diluye en café, snacks, delivery y transportes no registrados.
          </p>
        </div>

        <!-- Ahorro rescatado mes 1 -->
        <div class="bg-emerald-50/70 rounded-2xl p-5 border border-emerald-100 text-center sm:text-left space-y-1">
          <div class="text-xs font-bold text-emerald-700 uppercase tracking-wider flex items-center justify-center sm:justify-start gap-1">
            <span>🛡️</span> Rescate Mes 1
          </div>
          <div id="monthlyRecoveredDisplay" class="text-2xl sm:text-3xl font-black text-emerald-600">
            $560,000
          </div>
          <p class="text-[11px] text-emerald-600/90 leading-tight">
            Ahorro consciente recuperado con recordatorios y cierres automáticos.
          </p>
        </div>

        <!-- Ahorro proyectado anual -->
        <div class="bg-amber-50/70 rounded-2xl p-5 border border-amber-100 text-center sm:text-left space-y-1">
          <div class="text-xs font-bold text-amber-800 uppercase tracking-wider flex items-center justify-center sm:justify-start gap-1">
            <span>💰</span> Ahorro en 1 Año
          </div>
          <div id="yearlySavedDisplay" class="text-2xl sm:text-3xl font-black text-amber-600">
            $6,720,000
          </div>
          <p class="text-[11px] text-amber-700/90 leading-tight">
            Capital libre para inversiones, fondos de emergencia o tus próximas vacaciones.
          </p>
        </div>

      </div>

      <!-- Action Footer inside Calculator -->
      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-xs text-[#4A5568] text-center sm:text-left">
          💡 <strong>Sin descargar apps ni compartir contraseñas:</strong> Todo ocurre en tu WhatsApp.
        </div>
        <a 
          href="https://wa.me/573332937647" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#25D366] text-white font-bold text-sm shadow-md hover:bg-[#1ebd59] transition-colors"
        >
          <span>Empezar a Ahorrar en WhatsApp</span>
          <span>→</span>
        </a>
      </div>

    </div>

  </div>

</section>

<!-- Calculator Logic JS Script -->
<script>
  const slider = document.getElementById('incomeSlider') as HTMLInputElement;
  const incomeDisplay = document.getElementById('incomeDisplay');
  const monthlyLeak = document.getElementById('monthlyLeakDisplay');
  const monthlyRecovered = document.getElementById('monthlyRecoveredDisplay');
  const yearlySaved = document.getElementById('yearlySavedDisplay');

  function updateCalculator() {
    if (!slider) return;
    const income = parseInt(slider.value, 10);
    const leak = Math.round(income * 0.20);
    const recovered = Math.round(leak * 0.70);
    const yearly = recovered * 12;

    if (incomeDisplay) incomeDisplay.innerText = `$${income.toLocaleString('es-CO')}`;
    if (monthlyLeak) monthlyLeak.innerText = `$${leak.toLocaleString('es-CO')}`;
    if (monthlyRecovered) monthlyRecovered.innerText = `$${recovered.toLocaleString('es-CO')}`;
    if (yearlySaved) yearlySaved.innerText = `$${yearly.toLocaleString('es-CO')}`;
  }

  slider?.addEventListener('input', updateCalculator);
</script>
