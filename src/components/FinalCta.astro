---
/**
 * Closing call to action: dark panel with a hairline grid and a faint
 * brand glow. Marked [data-wa-fab-hide] so the floating WhatsApp button
 * (Footer) steps aside while this panel is on screen.
 */
import Icon from './ui/Icon.astro';
import Button from './ui/Button.astro';
import { waLink, WA_START_TEXT } from '../lib/site';

const assurances = ['Beta gratis de por vida', 'Sin tarjeta de crédito', 'Sin descargas'];
---

<section aria-labelledby="cta-title" class="bg-surface pb-20 sm:pb-28">
  <div class="container-page">
    <div
      class="relative isolate overflow-hidden rounded-3xl bg-ink px-5 py-16 text-center sm:px-12 sm:py-20"
      data-reveal
      data-wa-fab-hide
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-grid-dark mask-radial-fade"></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_55%_45%_at_50%_0%,rgb(16_185_129/0.18),transparent_70%)]"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/25 to-transparent"
      >
      </div>

      <p class="eyebrow justify-center text-zinc-400">
        <span class="size-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
        Empieza hoy
      </p>
      <h2
        id="cta-title"
        class="mx-auto mt-4 max-w-2xl text-3xl font-semibold tracking-[-0.03em] text-balance text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
      >
        Detén la fuga de dinero de tu quincena.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-balance text-zinc-300 sm:text-lg">
        Escribe a SmartSavings y registra tu primer gasto en menos de un minuto.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button variant="inverted" size="lg" href={waLink(WA_START_TEXT)} icon="whatsapp" class="w-full max-sm:px-5 max-sm:text-[15px] sm:w-auto">
          Empezar gratis en WhatsApp
        </Button>
        <Button variant="outline-inverted" size="lg" href="#precios" class="w-full max-sm:text-[15px] sm:w-auto">Ver precios</Button>
      </div>

      <ul class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-zinc-400">
        {
          assurances.map((item) => (
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="size-4 text-brand-400" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
