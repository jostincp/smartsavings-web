---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SmartSavings - Tu Asistente Financiero de Confianza">
  <!-- Navigation -->
  <nav class="fixed w-full bg-white/90 backdrop-blur-md z-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center gap-2">
          <svg class="w-8 h-8 text-emerald-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
          </svg>
          <span class="text-xl font-bold text-slate-700">SmartSavings</span>
        </div>
        <div class="hidden md:flex items-center gap-8">
          <a href="#features" class="text-slate-600 hover:text-slate-800 transition-colors">Funciones</a>
          <a href="#how-it-works" class="text-slate-600 hover:text-slate-800 transition-colors">Cómo funciona</a>
          <a href="#faq" class="text-slate-600 hover:text-slate-800 transition-colors">FAQ</a>
          <a href="https://wa.me/573332937647" target="_blank" rel="noopener" class="bg-slate-600 text-white px-5 py-2 rounded-full hover:bg-slate-700 transition-colors font-medium">
            Chatear ahora
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center pt-16 overflow-hidden bg-gradient-to-br from-amber-50 via-orange-50 to-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left Content -->
        <div class="space-y-8">
          <div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-700 px-4 py-2 rounded-full text-sm font-medium">
            <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
            Beta Gratuito - Acceso Inmediato
          </div>
          
          <h1 class="text-5xl lg:text-6xl font-bold text-slate-700 leading-tight">
            Tu Asistente Financiero de <span class="text-emerald-500">Confianza</span>
          </h1>
          
          <p class="text-xl text-slate-600 max-w-lg">
            Controla tus gastos sin fricción. SmartSavings funciona 100% dentro de WhatsApp. 
            Sin apps que descargar, sin formularios complejos.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://wa.me/573332937647" target="_blank" rel="noopener" 
               class="bg-slate-600 text-white px-8 py-4 rounded-full hover:bg-slate-700 transition-all transform hover:scale-105 font-semibold text-center flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Chatear con SmartSavings
            </a>
            <a href="#features" 
               class="bg-emerald-500 text-white px-8 py-4 rounded-full hover:bg-emerald-600 transition-all transform hover:scale-105 font-semibold text-center">
              Ver Funciones
            </a>
          </div>
          
          <div class="flex items-center gap-4 text-sm text-slate-500">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-slate-300 border-2 border-white"></div>
              <div class="w-8 h-8 rounded-full bg-emerald-300 border-2 border-white"></div>
              <div class="w-8 h-8 rounded-full bg-amber-300 border-2 border-white"></div>
            </div>
            <p>+500 usuarios ahorrando ya</p>
          </div>
        </div>
        
        <!-- Right Content - WhatsApp Mockup -->
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-emerald-400/20 to-blue-400/20 rounded-3xl blur-3xl"></div>
          <div class="relative bg-white rounded-3xl shadow-2xl p-4 max-w-sm mx-auto">
            <!-- WhatsApp Header -->
            <div class="bg-emerald-600 text-white p-4 rounded-t-2xl flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold">SmartSavings</p>
                <p class="text-xs text-emerald-100">en línea</p>
              </div>
            </div>
            
            <!-- Chat Messages -->
            <div class="bg-[#E5DDD5] p-4 space-y-3 rounded-b-2xl min-h-[400px]">
              <!-- Bot Message -->
              <div class="flex justify-start">
                <div class="bg-white rounded-lg rounded-tl-none p-3 max-w-[80%] shadow-sm">
                  <p class="text-sm text-gray-800">☀️ <strong>Pausa financiera.</strong></p>
                  <p class="text-sm text-gray-800 mt-1">¿Hiciste algún gasto esta mañana?</p>
                  <p class="text-xs text-gray-400 mt-1">09:00</p>
                </div>
              </div>
              
              <!-- Quick Reply Buttons -->
              <div class="flex flex-wrap gap-2">
                <button class="bg-emerald-600 text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-emerald-700 transition-colors">
                  📝 Registrar gasto
                </button>
                <button class="bg-white text-slate-700 px-4 py-2 rounded-full text-sm font-medium border border-gray-200 hover:bg-gray-50 transition-colors">
                  📊 Ver balance
                </button>
              </div>
              
              <!-- User Voice Message -->
              <div class="flex justify-end">
                <div class="bg-emerald-100 rounded-lg rounded-tr-none p-3 max-w-[80%]">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
                        <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
                      </svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center gap-1">
                        <div class="h-1 w-16 bg-emerald-400 rounded-full"></div>
                        <span class="text-xs text-gray-600">0:08</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Bot Response -->
              <div class="flex justify-start">
                <div class="bg-white rounded-lg rounded-tl-none p-3 max-w-[80%] shadow-sm">
                  <p class="text-sm text-gray-800">🎤 <strong>Audio procesado:</strong></p>
                  <p class="text-sm text-gray-800 mt-1">"Café y pan $12.500"</p>
                  <p class="text-xs text-gray-400 mt-1">✓ Transcripción automática</p>
                  <p class="text-xs text-gray-400">✓ Categorizado: Alimentación</p>
                  <p class="text-xs text-gray-400 mt-1">09:05</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-700 mb-4">¿Por qué SmartSavings?</h2>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Diseñado para freelancers y jóvenes profesionales que quieren controlar sus finanzas sin complicaciones.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl p-8 hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-emerald-500 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-700 mb-3">Registro Multimodal</h3>
          <p class="text-slate-600">
            Cero fricción. Registra gastos enviando texto, notas de voz, o la foto de una factura. 
            La IA extrae los datos automáticamente.
          </p>
        </div>
        
        <!-- Feature 2 -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-8 hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-slate-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-700 mb-3">Categorización Automática</h3>
          <p class="text-slate-600">
            La IA clasifica en qué se gastó el dinero sin formularios pesados. 
            Alimentación, transporte, entretenimiento... todo organizado.
          </p>
        </div>
        
        <!-- Feature 3 -->
        <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-2xl p-8 hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-emerald-500 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-700 mb-3">Alertas Proactivas</h3>
          <p class="text-slate-600">
            El bot envía notificaciones con botones interactivos al mediodía y a las 8 PM. 
            Ningún gasto hormiga se escapa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="py-24 bg-gradient-to-br from-slate-50 to-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-700 mb-4">Cómo funciona</h2>
        <p class="text-xl text-slate-600">Tres simples pasos para controlar tus finanzas</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-slate-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-xl font-bold text-slate-700 mb-2">Inicia el chat</h3>
          <p class="text-slate-600">Haz clic en "Chatear con SmartSavings" y envía un mensaje por WhatsApp.</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-emerald-500 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-xl font-bold text-slate-700 mb-2">Registra tus gastos</h3>
          <p class="text-slate-600">Envía texto, voz o fotos de tus recibos. La IA hace el resto.</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-slate-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-xl font-bold text-slate-700 mb-2">Visualiza tu progreso</h3>
          <p class="text-slate-600">Recibe resúmenes semanales y lleva el control de tus ahorros.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-700 mb-4">Precios</h2>
        <p class="text-xl text-slate-600">Comienza gratis y escala cuando lo necesites</p>
      </div>
      
      <div class="max-w-md mx-auto">
        <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-3xl p-8 text-white text-center shadow-2xl">
          <div class="inline-block bg-white/20 px-4 py-1 rounded-full text-sm font-medium mb-4">Beta Gratuito</div>
          <h3 class="text-3xl font-bold mb-2">Freemium</h3>
          <p class="text-emerald-100 mb-6">Acceso completo durante la beta</p>
          
          <div class="text-5xl font-bold mb-6">$0<span class="text-2xl">/mes</span></div>
          
          <ul class="text-left space-y-3 mb-8">
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-200" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Registro ilimitado de gastos
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-200" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Categorización automática
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-200" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Alertas proactivas
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-200" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              Soporte prioritario
            </li>
          </ul>
          
          <a href="https://wa.me/573332937647" target="_blank" rel="noopener" 
             class="block w-full bg-white text-emerald-600 py-4 rounded-full font-bold hover:bg-emerald-50 transition-colors">
            Comenzar ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-24 bg-gradient-to-br from-amber-50 to-orange-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-700 mb-4">Preguntas frecuentes</h2>
      </div>
      
      <div class="space-y-4">
        <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer">
          <summary class="font-semibold text-slate-700 text-lg">¿Necesito descargar una app?</summary>
          <p class="mt-4 text-slate-600">No. SmartSavings funciona 100% dentro de WhatsApp. Solo necesitas iniciar una conversación con nuestro número.</p>
        </details>
        
        <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer">
          <summary class="font-semibold text-slate-700 text-lg">¿Es seguro compartir mis datos financieros?</summary>
          <p class="mt-4 text-slate-600">Sí. No almacenamos datos bancarios sensibles. Solo registramos los montos y categorías que tú nos compartes voluntariamente.</p>
        </details>
        
        <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer">
          <summary class="font-semibold text-slate-700 text-lg">¿Cuánto tiempo dura la beta gratuita?</summary>
          <p class="mt-4 text-slate-600">La beta gratuita está activa indefinidamente mientras construimos las funciones premium. Los usuarios beta tendrán beneficios especiales.</p>
        </details>
        
        <details class="bg-white rounded-xl p-6 shadow-sm cursor-pointer">
          <summary class="font-semibold text-slate-700 text-lg">¿Puedo exportar mis datos?</summary>
          <p class="mt-4 text-slate-600">Sí. Puedes solicitar un resumen de tus gastos en cualquier momento escribiendo "resumen" o "exportar" en el chat.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-slate-700">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold text-white mb-6">¿Listo para controlar tus finanzas?</h2>
      <p class="text-xl text-slate-300 mb-8">Únete a +500 usuarios que ya están ahorrando con SmartSavings</p>
      <a href="https://wa.me/573332937647" target="_blank" rel="noopener" 
         class="inline-flex items-center gap-3 bg-emerald-500 text-white px-8 py-4 rounded-full text-lg font-bold hover:bg-emerald-600 transition-all transform hover:scale-105">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
